#!/bin/sh
# Standalone safe launcher for NAOMI TUI (/usr/local/bin/naomi-tui-launch)
# Guarantees: TTY check, recursion guard, clean terminal restoration, crash fallback.

TUI_BIN="${NAOMI_TUI_BIN:-/usr/local/bin/naomi-tui}"

if [ ! -t 0 ] || [ ! -t 1 ]; then
  echo "naomi-tui-launch: interactive TTY required." >&2
  exit 1
fi

if [ -n "${NAOMI_TUI_ACTIVE:-}" ]; then
  echo "naomi-tui-launch: already inside an active NAOMI TUI session." >&2
  exit 0
fi

if [ ! -x "$TUI_BIN" ]; then
  echo "naomi-tui-launch: binary not found or not executable: $TUI_BIN" >&2
  exit 127
fi

# Run as a child process (never exec) so exiting or crashing always returns to the shell.
NAOMI_TUI_ACTIVE=1 "$TUI_BIN" "$@"
STATUS=$?

# Safety net: restore terminal state even if the TUI crashed or was killed by a signal.
stty sane 2>/dev/null || true
printf '\033[?1049l\033[?25h\033[0m'

if [ "$STATUS" -ne 0 ]; then
  echo "NAOMI TUI exited with status $STATUS; returning to shell." >&2
fi

exit "$STATUS"
