			phandle = <0x0d>;
		};

		clock-controller@10a00000 {
			compatible = "samsung,exynos990-cmu-hsi0";
			reg = <0x10a00000 0x8000>;
			#clock-cells = <0x01>;
			clocks = <0x0c 0x0d 0x5d 0x0d 0x5f 0x0d 0x60 0x0d 0x5e>;
			clock-names = "oscclk", "dout_hsi0_bus", "dout_hsi0_usb31drd", "dout_hsi0_usbdp_debug", "dout_hsi0_dpgtc";
			phandle = <0x32>;
		};

