		usi@108400c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x108400c0 0x20>;
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			clocks = <0x2a 0x2a>;
			clock-names = "pclk", "ipclk";
