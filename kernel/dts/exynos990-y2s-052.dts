				cs35l41@41 {
					#sound-dai-cells = <0x01>;
					compatible = "cirrus,cs35l41";
					reg = <0x41>;
					reset-gpios = <0x27 0x04 0x00>;
					VA-supply = <0x28>;
					VP-supply = <0x29>;
					cirrus,boost-peak-milliamp = <0x1004>;
					cirrus,boost-ind-nanohenry = <0x3e8>;
