					reg = <0x40>;
					reset-gpios = <0x27 0x05 0x00>;
					VA-supply = <0x28>;
					VP-supply = <0x29>;
					cirrus,boost-peak-milliamp = <0x1004>;
					cirrus,boost-ind-nanohenry = <0x3e8>;
					cirrus,boost-cap-microfarad = <0x04>;
					cirrus,gpio2-src-select = <0x04>;
