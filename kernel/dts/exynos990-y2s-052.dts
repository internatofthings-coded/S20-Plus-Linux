				fuelgauge@36 {
					compatible = "maxim,max17050";
					reg = <0x36>;
					maxim,rsns-microohm = <0x1388>;
					maxim,dead-volt = <3300>;
					maxim,over-volt = <4400>;
					maxim,cold-temp = <0>;
					maxim,over-heat-temp = <420>;
					power-supplies = <0x23>;
				};

				charger@69 {
					compatible = "maxim,max77705-charger";
					reg = <0x69>;
					monitored-battery = <0x24>;
					phandle = <0x23>;
				};
			};
		};

		usi@106800c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x106800c0 0x20>;
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			clocks = <0x25 0x25>;
			clock-names = "pclk", "ipclk";
			samsung,mode = <0x03>;
			samsung,clkreq-on;
			status = "disabled";

			i2c@10680000 {
				compatible = "samsung,exynosautov9-hsi2c";
				reg = <0x10680000 0xc0>;
				interrupts = <0x00 0x19e 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <0x25 0x25>;
				clock-names = "hsi2c", "hsi2c_pclk";
				pinctrl-names = "default";
				pinctrl-0 = <0x26>;
