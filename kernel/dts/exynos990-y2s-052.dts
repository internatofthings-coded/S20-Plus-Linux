			reg = <0x132e0000 0x2000>;
			interrupts = <0x00 0x139 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x0d 0xa9 0x0d 0xaa>;
			clock-names = "biu", "ciu";
			fifo-depth = <0x40>;
			card-detect-delay = <0xc8>;
			clock-frequency = <0x2faf0800>;
			samsung,dw-mshc-ciu-div = <0x03>;
			samsung,dw-mshc-sdr-timing = <0x03 0x00 0x02 0x00>;
			samsung,dw-mshc-ddr-timing = <0x03 0x00 0x02 0x01>;
			pinctrl-names = "default";
			pinctrl-0 = <0x15 0x16 0x17 0x18>;
			bus-width = <0x04>;
			broken-cd;
			disable-wp;
			max-frequency = <0x17d7840>;
			cap-sd-highspeed;
			status = "disabled";
		};

		phy@13104000 {
			compatible = "samsung,exynos990-ufs-phy";
			reg = <0x13104000 0x3000>;
			reg-names = "phy-pma";
			samsung,pmu-syscon = <0x19>;
			#phy-cells = <0x00>;
			clocks = <0x0c>;
			clock-names = "ref_clk";
			status = "okay";
			phandle = <0x12>;
		};

		syscon@10720000 {
			compatible = "samsung,exynos990-peric1-sysreg", "syscon";
			reg = <0x10720000 0x10000>;
			phandle = <0x1b>;
		};

		usi@108d00c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x108d00c0 0x20>;
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			clocks = <0x1a 0x1a>;
			clock-names = "pclk", "ipclk";
			samsung,sysreg = <0x1b 0x1024>;
			samsung,mode = <0x03>;
			status = "okay";

			i2c@108d0000 {
				compatible = "samsung,exynosautov9-hsi2c";
				reg = <0x108d0000 0xc0>;
				interrupts = <0x00 0x1a4 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <0x1a 0x1a>;
				clock-names = "hsi2c", "hsi2c_pclk";
				pinctrl-names = "default";
				pinctrl-0 = <0x1c>;
				status = "okay";

				touchscreen@48 {
					compatible = "samsung,s6sy761";
					reg = <0x48>;
					interrupt-parent = <0x1d>;
					interrupts = <0x00 0x08>;
					vdd-supply = <0x1e>;
					avdd-supply = <0x1f>;
				};
			};
		};

		syscon@10420000 {
			compatible = "samsung,exynos990-peric0-sysreg", "syscon";
			reg = <0x10420000 0x10000>;
			phandle = <0x20>;
		};

		usi@105900c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x105900c0 0x20>;
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			clocks = <0x1a 0x1a>;
			clock-names = "pclk", "ipclk";
			samsung,sysreg = <0x20 0x1014>;
			samsung,mode = <0x03>;
			status = "okay";

			i2c@10590000 {
				compatible = "samsung,exynosautov9-hsi2c";
				reg = <0x10590000 0xc0>;
				interrupts = <0x00 0x193 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <0x1a 0x1a>;
				clock-names = "hsi2c", "hsi2c_pclk";
				pinctrl-names = "default";
				pinctrl-0 = <0x21>;
				status = "okay";

				pmic@60 {
					compatible = "samsung,s2dos05";
					reg = <0x60>;

					regulators {

						ldo2 {
							regulator-name = "tsp_io";
							regulator-min-microvolt = <0x1b7740>;
							regulator-max-microvolt = <0x1b7740>;
							regulator-boot-on;
							phandle = <0x1e>;
						};

						ldo3 {
							regulator-name = "tsp_avdd";
							regulator-min-microvolt = <0x2dc6c0>;
							regulator-max-microvolt = <0x2dc6c0>;
							regulator-boot-on;
							phandle = <0x1f>;
						};
					};
				};
			};
		};

		usi@105c00c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x105c00c0 0x20>;
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			clocks = <0x1a 0x1a>;
			clock-names = "pclk", "ipclk";
			samsung,sysreg = <0x20 0x1020>;
			samsung,mode = <0x03>;
			status = "okay";

			i2c@105c0000 {
				compatible = "samsung,exynosautov9-hsi2c";
				reg = <0x105c0000 0xc0>;
				interrupts = <0x00 0x194 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clocks = <0x1a 0x1a>;
				clock-names = "hsi2c", "hsi2c_pclk";
				pinctrl-names = "default";
