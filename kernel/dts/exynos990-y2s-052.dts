/dts-v1/;

/ {
	compatible = "samsung,y2s", "samsung,exynos990";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Samsung Galaxy S20+ SM-G985F";

	aliases {
		pinctrl0 = "/soc@0/pinctrl@15850000";
		pinctrl1 = "/soc@0/pinctrl@15c30000";
		pinctrl2 = "/soc@0/pinctrl@13040000";
		pinctrl3 = "/soc@0/pinctrl@13c30000";
		pinctrl4 = "/soc@0/pinctrl@10430000";
		pinctrl5 = "/soc@0/pinctrl@10730000";
		pinctrl6 = "/soc@0/pinctrl@15580000";
	};

	arm-a55-pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x00 0xa3 0x04 0x00 0xa4 0x04 0x00 0xa5 0x04 0x00 0xa6 0x04>;
		interrupt-affinity = <0x02 0x03 0x04 0x05>;
	};

	arm-a76-pmu {
		compatible = "arm,cortex-a76-pmu";
		interrupts = <0x00 0xa7 0x04 0x00 0xa8 0x04>;
		interrupt-affinity = <0x06 0x07>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x09>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x14a>;
			#cooling-cells = <0x02>;
			phandle = <0x02>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x14a>;
			phandle = <0x03>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x02>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x14a>;
			phandle = <0x04>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x14a>;
			phandle = <0x05>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x04>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x05>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x07>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m5";
			reg = <0x06>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;
		};

		cpu@201 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m5";
			reg = <0x07>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x09>;
		};
	};

	clock-osc {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "oscclk";
		clock-frequency = <0x18cba80>;
		phandle = <0x0c>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "hvc";
	};

	ufs-unipro {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
	};

	ufs-core-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x9ed8ac4>;
		phandle = <0x0f>;
	};

	clock-apm-mbox {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "apm_mbox_pclk";
		phandle = <0x31>;
	};

	firmware {

		power-management {
			compatible = "samsung,exynos990-acpm-ipc";
			mboxes = <0x0a>;
			shmem = <0x0b>;

		};
	};


	acpm-tmu {
		compatible = "samsung,exynos990-acpm-tmu";
		samsung,acpm-ipc-channel = <0x09>;
		#thermal-sensor-cells = <0x01>;
		phandle = <0x40>;
	};

	thermal-zones {
		big-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <0x40 0x00>;

			trips {
				big-passive {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
					phandle = <0x41>;
				};

				big-critical {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <0x41>;
					cooling-device = <0x08 0xffffffff 0xffffffff>;
				};
			};
		};

		mid-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <0x40 0x01>;

			trips {
				mid-passive {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
					phandle = <0x42>;
				};

				mid-critical {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <0x42>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};
			};
		};

		little-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <0x40 0x02>;

			trips {
				little-passive {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
					phandle = <0x43>;
				};

				little-critical {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <0x43>;
					cooling-device = <0x02 0xffffffff 0xffffffff>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <500>;
			polling-delay = <1000>;
			thermal-sensors = <0x40 0x03>;

			trips {
				gpu-hot {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "hot";
				};
			};
		};

		isp-thermal {
			polling-delay-passive = <500>;
			polling-delay = <1000>;
			thermal-sensors = <0x40 0x04>;

			trips {
				isp-hot {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "hot";
				};
			};
		};

		npu-thermal {
			polling-delay-passive = <500>;
			polling-delay = <1000>;
			thermal-sensors = <0x40 0x05>;

			trips {
				npu-hot {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "hot";
				};
			};
		};
	};

	gpu-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x2faf0800>;
		clock-output-names = "gpu_clk";
		phandle = <0x2f>;
	};

	tsp-i2c-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "tsp_i2c_clk";
		phandle = <0x1a>;
	};

	amp-i2c-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "amp_i2c_clk";
		phandle = <0x25>;
	};

	regulator-amp-va {
		compatible = "regulator-fixed";
		regulator-name = "cs35l41-va";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		phandle = <0x28>;
	};

	regulator-amp-vp {
		compatible = "regulator-fixed";
		regulator-name = "cs35l41-vp";
		regulator-min-microvolt = <0x39fbc0>;
		regulator-max-microvolt = <0x39fbc0>;
		regulator-always-on;
		phandle = <0x29>;
	};

	bt-uart-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "bt_uart_clk";
		phandle = <0x2a>;
	};

	battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		voltage-max-design-microvolt = <0x42d560>;
		voltage-min-design-microvolt = <0x325aa0>;
		charge-full-design-microamp-hours = <0x44aa20>;
		constant-charge-voltage-max-microvolt = <0x42d560>;
		constant-charge-current-max-microamp = <0x200b20>;
		charge-term-current-microamp = <0x57e40>;
		phandle = <0x24>;
	};

	regulator-tsp-vdd {
		compatible = "regulator-fixed";
		regulator-name = "tsp_vdd";
		regulator-always-on;
	};

	regulator-tsp-avdd {
		compatible = "regulator-fixed";
		regulator-name = "tsp_avdd";
		regulator-always-on;
	};

	soc@0 {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x20000000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		chipid@10000000 {
			compatible = "samsung,exynos990-chipid", "samsung,exynos850-chipid";
			reg = <0x10000000 0x100>;
		};

		interrupt-controller@10101000 {
			compatible = "arm,gic-400";
			reg = <0x10101000 0x1000 0x10102000 0x1000 0x10104000 0x2000 0x10106000 0x2000>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			interrupts = <0x01 0x09 0xff04>;
			#address-cells = <0x00>;
			#size-cells = <0x01>;
			phandle = <0x01>;
		};

		pinctrl@10430000 {
			compatible = "samsung,exynos990-pinctrl";
			reg = <0x10430000 0x1000>;
			interrupts = <0x00 0x188 0x04>;

			gpg0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp2-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp3-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp4-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			hsi2c0-bus-pins {
				samsung,pins = "gpp0-0", "gpp0-1";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c1-bus-pins {
				samsung,pins = "gpp0-2", "gpp0-3";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c2-bus-pins {
				samsung,pins = "gpp0-4", "gpp0-5";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c3-bus-pins {
				samsung,pins = "gpp0-6", "gpp0-7";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c4-bus-pins {
				samsung,pins = "gpp1-0", "gpp1-1";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				samsung,pin-con-pdn = <0x02>;
				samsung,pin-pud-pdn = <0x00>;
				phandle = <0x21>;
			};

			hsi2c5-bus-pins {
				samsung,pins = "gpp1-2", "gpp1-3";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c6-bus-pins {
				samsung,pins = "gpp1-4", "gpp1-5";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c7-bus-pins {
				samsung,pins = "gpp1-6", "gpp1-7";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x22>;
			};

			hsi2c31-bus-pins {
				samsung,pins = "gpp4-2", "gpp4-3";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x26>;
			};

			hsi2c8-bus-pins {
				samsung,pins = "gpp2-0", "gpp2-1";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c9-bus-pins {
				samsung,pins = "gpp2-2", "gpp2-3";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c10-bus-pins {
				samsung,pins = "gpp2-4", "gpp2-5";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c11-bus-pins {
				samsung,pins = "gpp2-6", "gpp2-7";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c26-bus-pins {
				samsung,pins = "gpp3-0", "gpp3-1";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c27-bus-pins {
				samsung,pins = "gpp3-2", "gpp3-3";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				samsung,pin-con-pdn = <0x02>;
				samsung,pin-pud-pdn = <0x00>;
			};

			hsi2c28-bus-pins {
				samsung,pins = "gpp3-4", "gpp3-5";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c29-bus-pins {
				samsung,pins = "gpp3-6", "gpp3-7";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			hsi2c30-bus-pins {
				samsung,pins = "gpp4-0", "gpp4-1";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi0-bus-pins {
				samsung,pins = "gpp0-2", "gpp0-1", "gpp0-0";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi0-cs-pins {
				samsung,pins = "gpp0-3";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi0-cs-func-pins {
				samsung,pins = "gpp0-3";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi1-bus-pins {
				samsung,pins = "gpp0-6", "gpp0-5", "gpp0-4";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi1-cs-pins {
				samsung,pins = "gpp0-7";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi1-cs-func-pins {
				samsung,pins = "gpp0-7";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi2-bus-pins {
				samsung,pins = "gpp1-2", "gpp1-1", "gpp1-0";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi2-cs-pins {
				samsung,pins = "gpp1-3";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi2-cs-func-pins {
				samsung,pins = "gpp1-3";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi3-bus-pins {
				samsung,pins = "gpp1-6", "gpp1-5", "gpp1-4";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi3-cs-pins {
				samsung,pins = "gpp1-7";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi3-cs-func-pins {
				samsung,pins = "gpp1-7";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi4-bus-pins {
				samsung,pins = "gpp2-2", "gpp2-1", "gpp2-0";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi4-cs-pins {
				samsung,pins = "gpp2-3";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi4-cs-func-pins {
				samsung,pins = "gpp2-3";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi4-fp-inactive-pins {
				samsung,pins = "gpp2-3", "gpp2-2", "gpp2-1", "gpp2-0";
				samsung,pin-function = <0x00>;
				samsung,pin-pud = <0x01>;
				samsung,pin-drv = <0x00>;
			};

			spi4-fp-cs-func-high-pins {
				samsung,pins = "gpp2-3";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi5-bus-pins {
				samsung,pins = "gpp2-6", "gpp2-5", "gpp2-4";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi5-cs-pins {
				samsung,pins = "gpp2-7";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			spi5-cs-func-pins {
