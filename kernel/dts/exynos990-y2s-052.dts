	chosen {
		bootargs = "console=tty0 loglevel=4 maxcpus=8 clk_ignore_unused";
		stdout-path = "/chosen/framebuffer@f1000000";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer@f1000000 {
			format = "a8r8g8b8";
			stride = <0x1680>;
			height = <0xc80>;
			width = <0x5a0>;
			reg = <0x00 0xf1000000 0x00 0x1194000>;
			compatible = "simple-framebuffer";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x3ab00000 0x00 0xc1200000 0x00 0x1ee00000 0x00 0xe1900000 0x00 0x1e700000 0x08 0x80000000 0x01 0x7ec00000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer@f1000000 {
			reg = <0x00 0xf1000000 0x00 0x1194000>;
			no-map;
		};

		audio@f7fb0000 {
			reg = <0x00 0xf7fb0000 0x00 0x2a50000>;
			no-map;
			phandle = <0x3f>;
		};

		modem@f0000000 {
			reg = <0x00 0xf0000000 0x00 0x800000>;
		};

		modem@d0000000 {
			reg = <0x00 0xd0000000 0x00 0x4000000>;
		};

		el2-code@c1400000 {
			reg = <0x00 0xc1400000 0x00 0x200000>;
		};

		secure-camera@96000000 {
			reg = <0x00 0x96000000 0x00 0x3200000>;
		};

		debug@880000000 {
			reg = <0x08 0x80000000 0x00 0xad00000>;
		};

		reserved@80001000 {
			reg = <0x00 0x80001000 0x00 0x1000>;
		};

		reserved@80000000 {
			reg = <0x00 0x80000000 0x00 0x1000>;
		};

		reserved@fd900000 {
			reg = <0x00 0xfd900000 0x00 0x10000>;
		};

		reserved@fd910000 {
			reg = <0x00 0xfd910000 0x00 0x200000>;
		};

		reserved@fdb10000 {
			reg = <0x00 0xfdb10000 0x00 0x400000>;
		};

		reserved@fdf10000 {
			reg = <0x00 0xfdf10000 0x00 0x100000>;
		};

		reserved@eb310000 {
			reg = <0x00 0xeb310000 0x00 0x1500000>;
		};

		reserved@fe010000 {
			reg = <0x00 0xfe010000 0x00 0xa00000>;
		};

		reserved@ec810000 {
			reg = <0x00 0xec810000 0x00 0xa00000>;
		};

		reserved@fea10000 {
			reg = <0x00 0xfea10000 0x00 0x100000>;
		};

		reserved@feb10000 {
			reg = <0x00 0xfeb10000 0x00 0x400000>;
		};

		reserved@fef10000 {
			reg = <0x00 0xfef10000 0x00 0x400000>;
		};

		reserved@ff310000 {
			reg = <0x00 0xff310000 0x00 0xf0000>;
		};

		reserved@eb308000 {
			reg = <0x00 0xeb308000 0x00 0x8000>;
		};

		reserved@ff400000 {
			reg = <0x00 0xff400000 0x00 0x800000>;
		};

		reserved@ffc00000 {
			reg = <0x00 0xffc00000 0x00 0x400000>;
		};

		reserved@c3000000 {
			reg = <0x00 0xc3000000 0x00 0x80000>;
		};

		reserved@f4200000 {
			reg = <0x00 0xf4200000 0x00 0x800000>;
		};

		reserved@ed210000 {
			reg = <0x00 0xed210000 0x00 0x100000>;
		};

		reserved@ed310000 {
			reg = <0x00 0xed310000 0x00 0x2000>;
		};

		reserved@f6200000 {
			reg = <0x00 0xf6200000 0x00 0x1000>;
		};

		reserved@f7200000 {
			reg = <0x00 0xf7200000 0x00 0x1000>;
		};

		s2mpu-table@c1800000 {
			compatible = "exynos,s2mpu_table";
			reg = <0x00 0xc1800000 0x00 0x300000>;
			no-map;
		};
	};

	s2mpu {
		compatible = "samsung,exynos-s2mpu";
		instance-num = <0x22>;
		instance-names = "aud", "csis_d0", "csis_d1", "dpu0", "dpu1", "dpu2", "ipp", "tnr_d0", "tnr_d1", "dns", "mcsc_d0", "mcsc_d1", "g2d_d0", "g2d_d1", "g2d_d2", "dnc_d0", "dnc_d1", "dnc_d2", "dnc_d3", "dnc_d4", "vra", "mfc_d0", "mfc_d1", "hsi0", "hsi1", "hsi2", "acvps", "secu", "dit", "sbic", "g3d0", "g3d1", "g3d2", "g3d3";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x34 0x35 0x36>;
		pinctrl-names = "default";

		power-key {
			label = "Power";
			linux,code = <0x74>;
			gpios = <0x2e 0x04 0x01>;
			wakeup-source;
		};

		voldown-key {
			label = "Volume Down";
			linux,code = <0x72>;
			gpios = <0x37 0x04 0x01>;
		};

		volup-key {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0x37 0x03 0x01>;
		};
	};

	regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan-enable";
		gpio = <0x38 0x04 0x00>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		pinctrl-names = "default";
		pinctrl-0 = <0x39>;
		phandle = <0x3d>;
	};

	pcie@133b0000 {
		compatible = "samsung,exynos990-pcie";
		reg = <0x00 0x133b0000 0x00 0x1000 0x00 0x133e0000 0x00 0x1000 0x00 0x133f0000 0x00 0x1000 0x00 0x133d0000 0x00 0x1fc 0x00 0x11ffe000 0x00 0x2000 0x00 0x13000000 0x00 0x4000>;
		reg-names = "elbi", "phy", "dbi", "pcs", "config", "cmu";
		interrupts = <0x00 0x13a 0x04>;
		interrupt-names = "pcie";
		#interrupt-cells = <0x01>;
		interrupt-map-mask = <0x00 0x00 0x00 0x00>;
		interrupt-map = <0x00 0x00 0x00 0x00 0x01 0x00 0x13a 0x04>;
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		device_type = "pci";
		linux,pci-domain = <0x00>;
		bus-range = <0x00 0xff>;
		ranges = <0x82000000 0x00 0x11000000 0x00 0x11000000 0x00 0xff0000>;
		num-lanes = <0x01>;
		max-link-speed = <0x01>;
		reset-gpios = <0x3a 0x01 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x3b 0x3c>;
		clocks = <0x0d 0xab>;
		clock-names = "pcie";
		samsung,sysreg = <0x13>;
		samsung,pmu = <0x19>;
		vpcie-supply = <0x3d>;
		status = "okay";
	};

	abox@18c50000 {
		compatible = "z3s,abox-poc";
		reg = <0x00 0x18c50000 0x00 0x10000 0x00 0x18c10000 0x00 0x10000 0x00 0x18d00000 0x00 0x78c00 0x00 0x18ce0000 0x00 0x10000 0x00 0x18e50000 0x00 0x1000>;
		reg-names = "sfr", "sysreg", "sram", "timer", "sysmmu";
		clocks = <0x3e 0x0d 0x3e 0x10 0x3e 0x01 0x3e 0x08 0x3e 0x0e 0x3e 0x0f 0x3e 0x11>;
		clock-names = "bus", "sysreg", "pll", "audif", "cnt", "uaif3", "smmu";
		power-domains = <0x0e>;
		memory-region = <0x3f>;
		status = "disabled";
	};

	regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <0x2d 0x00 0x00>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x14>;
	};
};
