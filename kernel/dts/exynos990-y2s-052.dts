		ufs@13100000 {
			compatible = "samsung,exynos990-ufs";
			reg = <0x13100000 0x200 0x13101100 0x200 0x13180000 0x8000 0x132a0000 0x100>;
			reg-names = "hci", "vs_hci", "unipro", "ufsp";
			interrupts = <0x00 0x141 0x04>;
			clocks = <0x0f 0x0f>;
			clock-names = "core_clk", "sclk_unipro_main";
			dma-coherent;
			freq-table-hz = <0x00 0x00 0x00 0x00>;
			pinctrl-0 = <0x10 0x11>;
			pinctrl-names = "default";
			phys = <0x12>;
			phy-names = "ufs-phy";
			samsung,sysreg = <0x13 0x700>;
			status = "okay";
			vcc-supply = <0x14>;
		};

