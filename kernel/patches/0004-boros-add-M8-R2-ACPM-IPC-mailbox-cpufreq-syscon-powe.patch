diff --git a/drivers/power/supply/max77705_charger.c b/drivers/power/supply/max77705_charger.c
new file mode 100644
index 000000000..e9bcaa2cf
--- /dev/null
+++ b/drivers/power/supply/max77705_charger.c
@@ -0,0 +1,924 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Based on max77650-charger.c
+ *
+ * Copyright (C) 2025 Dzmitry Sankouski <dsankouski@gmail.com>
+ *
+ * Battery charger driver for MAXIM 77705 charger/power-supply.
+ *
+ * Boot-042 R2 Safety Hardening (y2s / SM-G985F):
+ *   - Issue C: In-kernel fail-safe battery-pack thermal protection polling
+ *     max170xx_battery every 5s with y2s thresholds (stop >= 42.0 C or <= 0.0 C,
+ *     hysteresis recovery [2.0 C .. 40.0 C]), fail-safe disable if sensor is
+ *     missing, out-of-range, unreadable, or stale (> 30s).
+ *   - Issue D: Preserve hardware fast-charge safety timer (10h) and pre-qual
+ *     trickle charge; enforce DT/hardware current ceiling (<= 2.1 A), apply
+ *     conservative 1.0 A boot defaults, reject out-of-range sysfs writes with
+ *     -EINVAL, and fix CHGIN register step encoding.
+ */
+
+#include <linux/devm-helpers.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/mfd/max77693-common.h>
+#include <linux/mfd/max77705-private.h>
+#include <linux/power/max77705_charger.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+/* z3s backport: devm_alloc_ordered_workqueue landed upstream after this
+ * kernel base; provide an equivalent via a devm action. */
+static inline void z3s_destroy_wq(void *wq)
+{
+	destroy_workqueue(wq);
+}
+static inline struct workqueue_struct *
+z3s_devm_alloc_ordered_wq(struct device *dev, const char *name)
+{
+	struct workqueue_struct *wq = alloc_ordered_workqueue("%s", 0, name);
+
+	if (!wq)
+		return NULL;
+	if (devm_add_action_or_reset(dev, z3s_destroy_wq, wq))
+		return NULL;
+	return wq;
+}
+#undef devm_alloc_ordered_workqueue
+#define devm_alloc_ordered_workqueue(dev, fmt, flags, arg) \
+	z3s_devm_alloc_ordered_wq(dev, arg)
+
+static const char *max77705_charger_model		= "max77705";
+static const char *max77705_charger_manufacturer	= "Maxim Integrated";
+
+static const struct regmap_config max77705_chg_regmap_config = {
+	.reg_base = MAX77705_CHG_REG_BASE,
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = MAX77705_CHG_REG_SAFEOUT_CTRL,
+};
+
+static enum power_supply_property max77705_charger_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+};
+
+static irqreturn_t max77705_aicl_irq(int irq, void *irq_drv_data)
+{
+	struct max77705_charger_data *chg = irq_drv_data;
+	unsigned int regval, irq_status;
+	int err;
+
+	err = regmap_read(chg->regmap, MAX77705_CHG_REG_INT_OK, &irq_status);
+	if (err < 0)
+		return IRQ_HANDLED;
+
+	while (!(irq_status & BIT(MAX77705_AICL_I))) {
+		err = regmap_field_read(chg->rfield[MAX77705_CHG_CHGIN_LIM], &regval);
+		if (err < 0)
+			return IRQ_HANDLED;
+
+		if (regval <= 3)
+			break;
+
+		regval--;
+
+		err = regmap_field_write(chg->rfield[MAX77705_CHG_CHGIN_LIM], regval);
+		if (err < 0)
+			return IRQ_HANDLED;
+
+		msleep(AICL_WORK_DELAY_MS);
+
+		err = regmap_read(chg->regmap, MAX77705_CHG_REG_INT_OK, &irq_status);
+		if (err < 0)
+			return IRQ_HANDLED;
+	}
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t max77705_chgin_irq(int irq, void *irq_drv_data)
+{
+	struct max77705_charger_data *chg = irq_drv_data;
+
+	queue_work(chg->wqueue, &chg->chgin_work);
+
+	return IRQ_HANDLED;
+}
+
+static const struct regmap_irq max77705_charger_irqs[] = {
+	REGMAP_IRQ_REG_LINE(MAX77705_BYP_I, BITS_PER_BYTE),
+	REGMAP_IRQ_REG_LINE(MAX77705_INP_LIMIT_I, BITS_PER_BYTE),
+	REGMAP_IRQ_REG_LINE(MAX77705_BATP_I, BITS_PER_BYTE),
+	REGMAP_IRQ_REG_LINE(MAX77705_BAT_I, BITS_PER_BYTE),
+	REGMAP_IRQ_REG_LINE(MAX77705_CHG_I, BITS_PER_BYTE),
+	REGMAP_IRQ_REG_LINE(MAX77705_WCIN_I, BITS_PER_BYTE),
+	REGMAP_IRQ_REG_LINE(MAX77705_CHGIN_I, BITS_PER_BYTE),
+	REGMAP_IRQ_REG_LINE(MAX77705_AICL_I, BITS_PER_BYTE),
+};
+
+static const struct regmap_irq_chip max77705_charger_irq_chip = {
+	.name			= "max77705-charger",
+	.status_base		= MAX77705_CHG_REG_INT,
+	.mask_base		= MAX77705_CHG_REG_INT_MASK,
+	.num_regs		= 1,
+	.irqs			= max77705_charger_irqs,
+	.num_irqs		= ARRAY_SIZE(max77705_charger_irqs),
+};
+
+static int max77705_charger_set_enable_locked(struct max77705_charger_data *chg,
+					      bool enable)
+{
+	int rv;
+
+	rv = regmap_field_write(chg->rfield[MAX77705_CHG_EN],
+				enable ? 1 : MAX77705_CHG_DISABLE);
+	if (rv) {
+		dev_err(chg->dev, "unable to %s charger: %d\n",
+			enable ? "enable" : "disable", rv);
+		return rv;
+	}
+
+	chg->chg_enabled = enable;
+	return 0;
+}
+
+static void max77705_charger_disable_action(void *data)
+{
+	struct max77705_charger_data *chg = data;
+
+	mutex_lock(&chg->lock);
+	max77705_charger_set_enable_locked(chg, false);
+	mutex_unlock(&chg->lock);
+}
+
+static int max77705_get_online(struct regmap *regmap, int *val)
+{
+	unsigned int data;
+	int ret;
+
+	ret = regmap_read(regmap, MAX77705_CHG_REG_INT_OK, &data);
+	if (ret < 0)
+		return ret;
+
+	*val = !!(data & MAX77705_CHGIN_OK);
+
+	return 0;
+}
+
+static int max77705_set_cc_current_locked(struct max77705_charger_data *chg,
+					  int ua)
+{
+	unsigned int regval;
+
+	if (ua < MAX77705_CURRENT_CHGIN_MIN || ua > (int)chg->max_cc_ua)
+		return -EINVAL;
+
+	regval = ua / MAX77705_CURRENT_CHG_STEP;
+	return regmap_field_write(chg->rfield[MAX77705_CHG_CC_LIM], regval);
+}
+
+static int max77705_set_chgin_current_locked(struct max77705_charger_data *chg,
+					     int ua)
+{
+	unsigned int regval;
+
+	if (ua < MAX77705_CURRENT_CHGIN_MIN || ua > (int)chg->max_chgin_ua)
+		return -EINVAL;
+
+	/*
+	 * Matches max77705_get_input_current():
+	 *   reg_data <= 3 -> 100 mA
+	 *   reg_data >  3 -> (reg_data + 1) * 25 mA
+	 */
+	if (ua <= MAX77705_CURRENT_CHGIN_MIN)
+		regval = 3;
+	else
+		regval = (ua / MAX77705_CURRENT_CHGIN_STEP) - 1;
+
+	return regmap_field_write(chg->rfield[MAX77705_CHG_CHGIN_LIM], regval);
+}
+
+static int max77705_check_battery(struct max77705_charger_data *chg, int *val)
+{
+	unsigned int reg_data;
+	unsigned int reg_data2;
+	struct regmap *regmap = chg->regmap;
+
+	regmap_read(regmap, MAX77705_CHG_REG_INT_OK, &reg_data);
+	dev_dbg(chg->dev, "CHG_INT_OK(0x%x)\n", reg_data);
+
+	regmap_read(regmap, MAX77705_CHG_REG_DETAILS_00, &reg_data2);
+	dev_dbg(chg->dev, "CHG_DETAILS00(0x%x)\n", reg_data2);
+
+	if ((reg_data & MAX77705_BATP_OK) || !(reg_data2 & MAX77705_BATP_DTLS))
+		*val = true;
+	else
+		*val = false;
+
+	return 0;
+}
+
+static int max77705_get_charge_type(struct max77705_charger_data *chg, int *val)
+{
+	struct regmap *regmap = chg->regmap;
+	unsigned int reg_data, chg_en;
+
+	regmap_field_read(chg->rfield[MAX77705_CHG_EN], &chg_en);
+	if (!chg_en) {
+		*val = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		return 0;
+	}
+
+	regmap_read(regmap, MAX77705_CHG_REG_DETAILS_01, &reg_data);
+	reg_data &= MAX77705_CHG_DTLS;
+
+	switch (reg_data) {
+	case 0x0:
+	case MAX77705_CHARGER_CONSTANT_CURRENT:
+	case MAX77705_CHARGER_CONSTANT_VOLTAGE:
+		*val = POWER_SUPPLY_CHARGE_TYPE_FAST;
+		return 0;
+	default:
+		*val = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		return 0;
+	}
+}
+
+static int max77705_get_status(struct max77705_charger_data *chg, int *val)
+{
+	struct regmap *regmap = chg->regmap;
+	unsigned int reg_data, chg_en;
+
+	regmap_field_read(chg->rfield[MAX77705_CHG_EN], &chg_en);
+	if (!chg_en) {
+		*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	}
+
+	regmap_read(regmap, MAX77705_CHG_REG_DETAILS_01, &reg_data);
+	reg_data &= MAX77705_CHG_DTLS;
+
+	switch (reg_data) {
+	case 0x0:
+	case MAX77705_CHARGER_CONSTANT_CURRENT:
+	case MAX77705_CHARGER_CONSTANT_VOLTAGE:
+		*val = POWER_SUPPLY_STATUS_CHARGING;
+		return 0;
+	case MAX77705_CHARGER_END_OF_CHARGE:
+	case MAX77705_CHARGER_DONE:
+		*val = POWER_SUPPLY_STATUS_FULL;
+		return 0;
+	case 0x05:
+	case 0x06:
+	case 0x07:
+		*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	case 0x08:
+	case 0xA:
+	case 0xB:
+		*val = POWER_SUPPLY_STATUS_DISCHARGING;
+		return 0;
+	default:
+		*val = POWER_SUPPLY_STATUS_UNKNOWN;
+		return 0;
+	}
+}
+
+static int max77705_get_vbus_state(struct regmap *regmap, int *value)
+{
+	int ret;
+	unsigned int charge_dtls;
+
+	ret = regmap_read(regmap, MAX77705_CHG_REG_DETAILS_00, &charge_dtls);
+	if (ret)
+		return ret;
+
+	charge_dtls = ((charge_dtls & MAX77705_CHGIN_DTLS) >>
+			MAX77705_CHGIN_DTLS_SHIFT);
+
+	switch (charge_dtls) {
+	case 0x00:
+	case 0x01:
+		*value = POWER_SUPPLY_HEALTH_UNDERVOLTAGE;
+		break;
+	case 0x02:
+		*value = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+		break;
+	case 0x03:
+		*value = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	default:
+		return 0;
+	}
+	return 0;
+}
+
+static int max77705_get_battery_health(struct max77705_charger_data *chg,
+					int *value)
+{
+	struct regmap *regmap = chg->regmap;
+	unsigned int bat_dtls;
+
+	if (chg->thermal_state == MAX77705_THERM_OVERHEAT) {
+		*value = POWER_SUPPLY_HEALTH_OVERHEAT;
+		return 0;
+	}
+	if (chg->thermal_state == MAX77705_THERM_COLD) {
+		*value = POWER_SUPPLY_HEALTH_COLD;
+		return 0;
+	}
+	if (chg->thermal_state == MAX77705_THERM_FAULT) {
+		*value = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+		return 0;
+	}
+
+	regmap_read(regmap, MAX77705_CHG_REG_DETAILS_01, &bat_dtls);
+	bat_dtls = ((bat_dtls & MAX77705_BAT_DTLS) >> MAX77705_BAT_DTLS_SHIFT);
+
+	switch (bat_dtls) {
+	case MAX77705_BATTERY_NOBAT:
+		*value = POWER_SUPPLY_HEALTH_NO_BATTERY;
+		break;
+	case MAX77705_BATTERY_PREQUALIFICATION:
+		*value = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	case MAX77705_BATTERY_DEAD:
+		*value = POWER_SUPPLY_HEALTH_DEAD;
+		break;
+	case MAX77705_BATTERY_GOOD:
+	case MAX77705_BATTERY_LOWVOLTAGE:
+		*value = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	case MAX77705_BATTERY_OVERVOLTAGE:
+		*value = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+		break;
+	default:
+		*value = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+		break;
+	}
+
+	return 0;
+}
+
+static int max77705_get_health(struct max77705_charger_data *chg, int *val)
+{
+	struct regmap *regmap = chg->regmap;
+	int ret, is_online = 0;
+
+	ret = max77705_get_online(regmap, &is_online);
+	if (ret)
+		return ret;
+	if (is_online) {
+		ret = max77705_get_vbus_state(regmap, val);
+		if (ret || (*val != POWER_SUPPLY_HEALTH_GOOD))
+			return ret;
+	}
+	return max77705_get_battery_health(chg, val);
+}
+
+static int max77705_get_input_current(struct max77705_charger_data *chg,
+					int *val)
+{
+	unsigned int reg_data;
+	int get_current = 0;
+
+	regmap_field_read(chg->rfield[MAX77705_CHG_CHGIN_LIM], &reg_data);
+
+	if (reg_data <= 3)
+		get_current = MAX77705_CURRENT_CHGIN_MIN;
+	else
+		get_current = (reg_data + 1) * MAX77705_CURRENT_CHGIN_STEP;
+
+	*val = get_current;
+
+	return 0;
+}
+
+static int max77705_get_charge_current(struct max77705_charger_data *chg,
+					int *val)
+{
+	unsigned int reg_data;
+
+	regmap_field_read(chg->rfield[MAX77705_CHG_CC_LIM], &reg_data);
+
+	*val = reg_data <= 0x2 ? MAX77705_CURRENT_CHGIN_MIN : reg_data * MAX77705_CURRENT_CHG_STEP;
+
+	return 0;
+}
+
+static int max77705_set_float_voltage(struct max77705_charger_data *chg,
+					int float_voltage)
+{
+	int float_voltage_mv;
+	unsigned int reg_data = 0;
+
+	float_voltage_mv = float_voltage / 1000;
+	reg_data = float_voltage_mv <= 4000 ? 0x0 :
+		float_voltage_mv >= 4500 ? 0x23 :
+		(float_voltage_mv <= 4200) ? (float_voltage_mv - 4000) / 50 :
+		(((float_voltage_mv - 4200) / 10) + 0x04);
+
+	return regmap_field_write(chg->rfield[MAX77705_CHG_CV_PRM], reg_data);
+}
+
+static int max77705_get_float_voltage(struct max77705_charger_data *chg,
+					int *val)
+{
+	unsigned int reg_data = 0;
+	int voltage_mv;
+
+	regmap_field_read(chg->rfield[MAX77705_CHG_CV_PRM], &reg_data);
+	voltage_mv = reg_data <= 0x04 ? reg_data * 50 + 4000 :
+					(reg_data - 4) * 10 + 4200;
+	*val = voltage_mv * 1000;
+
+	return 0;
+}
+
+static int max77705_chg_get_property(struct power_supply *psy,
+					enum power_supply_property psp,
+					union power_supply_propval *val)
+{
+	struct max77705_charger_data *chg = power_supply_get_drvdata(psy);
+	struct regmap *regmap = chg->regmap;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		return max77705_get_online(regmap, &val->intval);
+	case POWER_SUPPLY_PROP_PRESENT:
+		return max77705_check_battery(chg, &val->intval);
+	case POWER_SUPPLY_PROP_STATUS:
+		return max77705_get_status(chg, &val->intval);
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		return max77705_get_charge_type(chg, &val->intval);
+	case POWER_SUPPLY_PROP_HEALTH:
+		return max77705_get_health(chg, &val->intval);
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return max77705_get_input_current(chg, &val->intval);
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		return max77705_get_charge_current(chg, &val->intval);
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		val->intval = chg->max_cc_ua;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		return max77705_get_float_voltage(chg, &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = chg->bat_info->voltage_max_design_uv;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = max77705_charger_model;
+		break;
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = max77705_charger_manufacturer;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int max77705_set_property(struct power_supply *psy,
+				 enum power_supply_property psp,
+				 const union power_supply_propval *val)
+{
+	struct max77705_charger_data *chg = power_supply_get_drvdata(psy);
+	int err;
+
+	mutex_lock(&chg->lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		err = max77705_set_cc_current_locked(chg, val->intval);
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		err = max77705_set_chgin_current_locked(chg, val->intval);
+		break;
+	default:
+		err = -EINVAL;
+		break;
+	}
+	mutex_unlock(&chg->lock);
+
+	return err;
+}
+
+static int max77705_property_is_writeable(struct power_supply *psy,
+					  enum power_supply_property psp)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static const struct power_supply_desc max77705_charger_psy_desc = {
+	.name = "max77705-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = max77705_charger_props,
+	.property_is_writeable = max77705_property_is_writeable,
+	.num_properties = ARRAY_SIZE(max77705_charger_props),
+	.get_property = max77705_chg_get_property,
+	.set_property = max77705_set_property,
+};
+
+static void max77705_chgin_isr_work(struct work_struct *work)
+{
+	struct max77705_charger_data *chg =
+		container_of(work, struct max77705_charger_data, chgin_work);
+
+	power_supply_changed(chg->psy_chg);
+}
+
+/*
+ * Fail-safe battery-pack thermal monitor:
+ * Queries live temperature from max170xx_battery (in deci-Celsius).
+ *   - Stop charging immediately if T >= 42.0 C or T <= 0.0 C.
+ *   - Resume charging ONLY inside hysteresis window [2.0 C .. 40.0 C].
+ *   - Fail-safe: if fuel gauge is missing, unreadable, out of sanity bounds
+ *     [-40.0 C .. 85.0 C], or stale (> 30 s), disable charging.
+ */
+static void max77705_thermal_check(struct max77705_charger_data *chg)
+{
+	struct power_supply *bat_psy;
+	union power_supply_propval prop;
+	enum max77705_thermal_state prev_state, next_state;
+	int temp_dc, ret;
+	bool allow_chg;
+
+	bat_psy = power_supply_get_by_name("max170xx_battery");
+
+	mutex_lock(&chg->lock);
+	prev_state = chg->thermal_state;
+
+	if (!bat_psy) {
+		if (!chg->has_valid_temp ||
+		    time_after(jiffies, chg->last_temp_jiffies +
+			       msecs_to_jiffies(MAX77705_TEMP_STALE_MS))) {
+			next_state = MAX77705_THERM_FAULT;
+			if (chg->chg_enabled || prev_state != next_state) {
+				dev_warn_ratelimited(chg->dev,
+					"thermal protection: fuel-gauge temperature unavailable, disabling charging\n");
+				max77705_charger_set_enable_locked(chg, false);
+			}
+			chg->thermal_state = next_state;
+			mutex_unlock(&chg->lock);
+			if (prev_state != next_state)
+				power_supply_changed(chg->psy_chg);
+			return;
+		}
+		mutex_unlock(&chg->lock);
+		return;
+	}
+
+	ret = power_supply_get_property(bat_psy, POWER_SUPPLY_PROP_TEMP, &prop);
+	power_supply_put(bat_psy);
+
+	if (ret < 0 || prop.intval < MAX77705_TEMP_SANITY_MIN_DC ||
+	    prop.intval > MAX77705_TEMP_SANITY_MAX_DC) {
+		next_state = MAX77705_THERM_FAULT;
+		if (chg->chg_enabled || prev_state != next_state) {
+			dev_warn_ratelimited(chg->dev,
+				"thermal protection: invalid battery temperature (ret=%d val=%d), disabling charging\n",
+				ret, prop.intval);
+			max77705_charger_set_enable_locked(chg, false);
+		}
+		chg->thermal_state = next_state;
+		mutex_unlock(&chg->lock);
+		if (prev_state != next_state)
+			power_supply_changed(chg->psy_chg);
+		return;
+	}
+
+	temp_dc = prop.intval;
+	chg->has_valid_temp = true;
+	chg->last_temp_dc = temp_dc;
+	chg->last_temp_jiffies = jiffies;
+
+	if (temp_dc >= MAX77705_TEMP_HIGH_STOP_DC) {
+		next_state = MAX77705_THERM_OVERHEAT;
+	} else if (temp_dc <= MAX77705_TEMP_LOW_STOP_DC) {
+		next_state = MAX77705_THERM_COLD;
+	} else if (prev_state == MAX77705_THERM_OVERHEAT &&
+		   temp_dc > MAX77705_TEMP_HIGH_RECOV_DC) {
+		next_state = MAX77705_THERM_OVERHEAT;
+	} else if (prev_state == MAX77705_THERM_COLD &&
+		   temp_dc < MAX77705_TEMP_LOW_RECOV_DC) {
+		next_state = MAX77705_THERM_COLD;
+	} else {
+		next_state = MAX77705_THERM_NORMAL;
+	}
+
+	allow_chg = (next_state == MAX77705_THERM_NORMAL);
+	if (!allow_chg && (chg->chg_enabled || prev_state != next_state)) {
+		dev_warn(chg->dev,
+			 "thermal protection: disabling charging (temp=%d.%d C, state=%d)\n",
+			 temp_dc / 10, abs(temp_dc % 10), next_state);
+		max77705_charger_set_enable_locked(chg, false);
+	} else if (allow_chg && !chg->chg_enabled) {
+		dev_info(chg->dev,
+			 "thermal protection: safe temperature (%d.%d C), enabling charging\n",
+			 temp_dc / 10, abs(temp_dc % 10));
+		max77705_charger_set_enable_locked(chg, true);
+	}
+
+	chg->thermal_state = next_state;
+	mutex_unlock(&chg->lock);
+
+	if (prev_state != next_state)
+		power_supply_changed(chg->psy_chg);
+}
+
+static int max77705_charger_initialize(struct max77705_charger_data *chg)
+{
+	struct power_supply_battery_info *info;
+	struct regmap *regmap = chg->regmap;
+	unsigned int init_cc_ua, init_chgin_ua;
+	int err;
+
+	err = power_supply_get_battery_info(chg->psy_chg, &info);
+	if (err)
+		return dev_err_probe(chg->dev, err, "error on getting battery info");
+
+	chg->bat_info = info;
+
+	/* Enforce validated y2s hardware & DT current ceilings */
+	if (info->constant_charge_current_max_ua > 0)
+		chg->max_cc_ua = min_t(unsigned int,
+				       info->constant_charge_current_max_ua,
+				       MAX77705_CURRENT_CC_MAX_SAFE);
+	else
+		chg->max_cc_ua = MAX77705_CURRENT_CC_DEFAULT;
+
+	chg->max_chgin_ua = min_t(unsigned int, chg->max_cc_ua,
+				  MAX77705_CURRENT_CHGIN_MAX_SAFE);
+
+	init_cc_ua = min_t(unsigned int, MAX77705_CURRENT_CC_DEFAULT, chg->max_cc_ua);
+	init_chgin_ua = min_t(unsigned int, MAX77705_CURRENT_CHGIN_DEFAULT, chg->max_chgin_ua);
+
+	/* Unlock charger setting protect; slowest LX slope */
+	err = regmap_field_write(chg->rfield[MAX77705_CHGPROT], MAX77705_CHGPROT_UNLOCKED);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_LX_SLOPE], MAX77705_SLOWEST_LX_SLOPE);
+	if (err)
+		goto err;
+
+	/*
+	 * Preserve hardware safety protections:
+	 *   - Fast-charge safety timer: 10 hours (FCHGTIME = 0x4)
+	 *   - Recharge threshold: 150 mV (CHG_RSTRT = 0x1)
+	 *   - Pre-qualification trickle charge: ENABLED (PQEN = 1)
+	 */
+	err = regmap_field_write(chg->rfield[MAX77705_FCHGTIME], MAX77705_FCHGTIME_10H);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_CHG_RSTRT], MAX77705_CHG_RSTRT_150MV);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_CHG_PQEN], MAX77705_CHG_PQEN_ENABLE);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_MODE],
+			MAX77705_CHG_MASK | MAX77705_BUCK_MASK);
+	if (err)
+		goto err;
+
+	/* Conservative boot-time fast-charge & CHGIN input current defaults */
+	err = max77705_set_cc_current_locked(chg, init_cc_ua);
+	if (err)
+		goto err;
+
+	err = max77705_set_chgin_current_locked(chg, init_chgin_ua);
+	if (err)
+		goto err;
+
+	/* OTG current limit 900mA */
+	err = regmap_field_write(chg->rfield[MAX77705_OTG_ILIM], MAX77705_OTG_ILIM_900);
+	if (err)
+		goto err;
+
+	/* BAT to SYS OCP 4.80A */
+	err = regmap_field_write(chg->rfield[MAX77705_REG_B2SOVRC], MAX77705_B2SOVRC_4_8A);
+	if (err)
+		goto err;
+
+	/* Top-off current 150mA, top-off timer 30min */
+	err = regmap_field_write(chg->rfield[MAX77705_TO], MAX77705_TO_ITH_150MA);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_TO_TIME], MAX77705_TO_TIME_30M);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_SYS_TRACK], MAX77705_SYS_TRACK_DISABLE);
+	if (err)
+		goto err;
+
+	/* Float voltage from DT (y2s: 4.38 V); conservative 4.2 V fallback */
+	if (info->voltage_max_design_uv < 0) {
+		dev_warn(chg->dev, "missing battery:voltage-max-design-microvolt, using 4.2V\n");
+		err = max77705_set_float_voltage(chg, 4200000);
+	} else {
+		err = max77705_set_float_voltage(chg, info->voltage_max_design_uv);
+	}
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_VCHGIN], MAX77705_VCHGIN_4_5);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_WCIN], MAX77705_WCIN_4_5);
+	if (err)
+		goto err;
+
+	/* Watchdog timer disabled (no userspace WDT kicker; FCHGTIME=10h active) */
+	regmap_update_bits(regmap, MAX77705_CHG_REG_CNFG_00,
+			   MAX77705_WDTEN_MASK, 0);
+
+	/* VBYPSET=5.0V */
+	err = regmap_field_write(chg->rfield[MAX77705_VBYPSET], 0);
+	if (err)
+		goto err;
+
+	/* Switching Frequency : 1.5MHz */
+	err = regmap_field_write(chg->rfield[MAX77705_REG_FSW], MAX77705_CHG_FSW_1_5MHz);
+	if (err)
+		goto err;
+
+	/* Auto skip mode */
+	err = regmap_field_write(chg->rfield[MAX77705_REG_DISKIP], MAX77705_AUTO_SKIP);
+	if (err)
+		goto err;
+
+	/* Start with charging disabled until thermal safety check succeeds */
+	err = max77705_charger_set_enable_locked(chg, false);
+	if (err)
+		goto err;
+
+	dev_info(chg->dev,
+		 "max77705 initialized: cc=%u uA chgin=%u uA max=%u uA fchgtime=10h pqen=1 thermal=[0.0..42.0 C]\n",
+		 init_cc_ua, init_chgin_ua, chg->max_cc_ua);
+
+	return 0;
+
+err:
+	return dev_err_probe(chg->dev, err, "error while configuring");
+}
+
+#define MAX77705_POLL_INTERVAL_MS 5000
+
+static void max77705_poll_work(struct work_struct *work)
+{
+	struct max77705_charger_data *chg =
+		container_of(work, struct max77705_charger_data, poll_work.work);
+	int online = 0;
+
+	max77705_thermal_check(chg);
+
+	if (!max77705_get_online(chg->regmap, &online) &&
+	    online != chg->last_online) {
+		chg->last_online = online;
+		power_supply_changed(chg->psy_chg);
+	}
+	schedule_delayed_work(&chg->poll_work,
+			      msecs_to_jiffies(MAX77705_POLL_INTERVAL_MS));
+}
+
+static int max77705_charger_probe(struct i2c_client *i2c)
+{
+	struct power_supply_config pscfg = {};
+	struct max77705_charger_data *chg;
+	struct regmap_irq_chip *chip_desc;
+	struct device *dev;
+	struct regmap_irq_chip_data *irq_data = NULL;
+	int ret;
+
+	dev = &i2c->dev;
+
+	chg = devm_kzalloc(dev, sizeof(*chg), GFP_KERNEL);
+	if (!chg)
+		return -ENOMEM;
+
+	chg->dev = dev;
+	chg->thermal_state = MAX77705_THERM_UNKNOWN;
+	chg->last_online = -1;
+	mutex_init(&chg->lock);
+	i2c_set_clientdata(i2c, chg);
+
+	chip_desc = devm_kmemdup(dev, &max77705_charger_irq_chip,
+				 sizeof(max77705_charger_irq_chip),
+				 GFP_KERNEL);
+	if (!chip_desc)
+		return -ENOMEM;
+	chip_desc->irq_drv_data = chg;
+
+	chg->regmap = devm_regmap_init_i2c(i2c, &max77705_chg_regmap_config);
+	if (IS_ERR(chg->regmap))
+		return PTR_ERR(chg->regmap);
+
+	for (int i = 0; i < MAX77705_N_REGMAP_FIELDS; i++) {
+		chg->rfield[i] = devm_regmap_field_alloc(dev, chg->regmap,
+							 max77705_reg_field[i]);
+		if (IS_ERR(chg->rfield[i]))
+			return dev_err_probe(dev, PTR_ERR(chg->rfield[i]),
+					     "cannot allocate regmap field\n");
+	}
+
+	pscfg.fwnode = dev_fwnode(dev);
+	pscfg.drv_data = chg;
+
+	chg->psy_chg = devm_power_supply_register(dev, &max77705_charger_psy_desc, &pscfg);
+	if (IS_ERR(chg->psy_chg))
+		return PTR_ERR(chg->psy_chg);
+
+	if (i2c->irq > 0) {
+		ret = devm_regmap_add_irq_chip(chg->dev, chg->regmap, i2c->irq,
+						IRQF_ONESHOT, 0,
+						chip_desc, &irq_data);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to add irq chip\n");
+
+		chg->wqueue = devm_alloc_ordered_workqueue(dev, "%s", 0, dev_name(dev));
+		if (!chg->wqueue)
+			return -ENOMEM;
+
+		ret = devm_work_autocancel(dev, &chg->chgin_work, max77705_chgin_isr_work);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to initialize interrupt work\n");
+	}
+
+	mutex_lock(&chg->lock);
+	ret = max77705_charger_initialize(chg);
+	mutex_unlock(&chg->lock);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to initialize charger IC\n");
+
+	if (i2c->irq > 0) {
+		ret = devm_request_threaded_irq(dev, regmap_irq_get_virq(irq_data, MAX77705_CHGIN_I),
+						NULL, max77705_chgin_irq,
+						IRQF_TRIGGER_NONE,
+						"chgin-irq", chg);
+		if (ret)
+			return ret;
+
+		ret = devm_request_threaded_irq(dev, regmap_irq_get_virq(irq_data, MAX77705_AICL_I),
+						NULL, max77705_aicl_irq,
+						IRQF_TRIGGER_NONE,
+						"aicl-irq", chg);
+		if (ret)
+			return ret;
+	}
+
+	/* Perform initial fail-safe thermal check before enabling charging */
+	max77705_thermal_check(chg);
+
+	/* Always run 5-second poll loop for thermal protection & CHGIN status */
+	ret = devm_delayed_work_autocancel(dev, &chg->poll_work,
+					   max77705_poll_work);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&chg->poll_work,
+			      msecs_to_jiffies(MAX77705_POLL_INTERVAL_MS));
+
+	return devm_add_action_or_reset(dev, max77705_charger_disable_action, chg);
+}
+
+static const struct of_device_id max77705_charger_of_match[] = {
+	{ .compatible = "maxim,max77705-charger" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, max77705_charger_of_match);
+
+static struct i2c_driver max77705_charger_driver = {
+	.driver = {
+		.name = "max77705-charger",
+		.of_match_table = max77705_charger_of_match,
+	},
+	.probe = max77705_charger_probe,
+};
+module_i2c_driver(max77705_charger_driver);
+
+MODULE_AUTHOR("Dzmitry Sankouski <dsankouski@gmail.com>");
+MODULE_DESCRIPTION("Maxim MAX77705 charger driver");
+MODULE_LICENSE("GPL");
