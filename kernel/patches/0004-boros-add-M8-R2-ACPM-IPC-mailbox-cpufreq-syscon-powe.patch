diff --git a/drivers/firmware/samsung/exynos-acpm.c b/drivers/firmware/samsung/exynos-acpm.c
new file mode 100644
index 000000000..2483f782c
--- /dev/null
+++ b/drivers/firmware/samsung/exynos-acpm.c
@@ -0,0 +1,1014 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright 2020 Samsung Electronics Co., Ltd.
+ * Copyright 2020 Google LLC.
+ * Copyright 2024 Linaro Ltd.
+ *
+ * Boot-042 R2 Safety Hardening (y2s / SM-G985F):
+ *   - Issue A: Atomic-safe locking (spinlock_t + SYS_OFF_MODE_POWER_OFF_PREPARE
+ *     quiesce barrier) and atomic polling (readl_poll_timeout_atomic, udelay,
+ *     ktime_get_mono_fast_ns) so acpm_power_off_notify() never sleeps or
+ *     deadlocks after local_irq_disable() + smp_send_stop().
+ *   - Issue B: Explicit boot-time S2MPS19 RTC WTSR/SMPL verification and
+ *     re-arming in acpm_probe() preserving timer bits, with readback check.
+ */
+
+#include <linux/atomic.h>
+#include <linux/bitfield.h>
+#include <linux/bitmap.h>
+#include <linux/bitops.h>
+#include <linux/container_of.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/find.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
+#include <linux/mailbox/exynos-message.h>
+#include <linux/mailbox_client.h>
+#include <linux/module.h>
+#include <linux/math.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+#include "exynos-acpm.h"
+#include "exynos-acpm-dvfs.h"
+#include "exynos-acpm-pmic.h"
+
+#define ACPM_PROTOCOL_SEQNUM		GENMASK(21, 16)
+
+#define ACPM_POLL_TIMEOUT_US		(100 * USEC_PER_MSEC)
+#define ACPM_TX_TIMEOUT_US		500000
+#define ACPM_SHUTDOWN_LOCK_TIMEOUT_US	(100 * USEC_PER_MSEC)
+
+/* AP2APM mailbox RX-direction (group 1) interrupt regs, mailbox-base relative. */
+#define ACPM_MBOX_INTCR1		0x20
+#define ACPM_MBOX_INTSR1		0x28
+
+#define ACPM_GS101_INITDATA_BASE	0xa000
+#define ACPM_EXYNOS990_INITDATA_BASE	0x7000
+
+struct acpm_shmem {
+	u32 reserved[2];
+	u32 chans;
+	u32 reserved1[3];
+	u32 num_chans;
+};
+
+struct acpm_chan_shmem {
+	u32 id;
+	u32 reserved[3];
+	u32 rx_rear;
+	u32 rx_front;
+	u32 rx_base;
+	u32 reserved1[3];
+	u32 tx_rear;
+	u32 tx_front;
+	u32 tx_base;
+	u32 qlen;
+	u32 mlen;
+	u32 reserved2[2];
+	u32 poll_completion;
+};
+
+struct acpm_queue {
+	void __iomem *rear;
+	void __iomem *front;
+	void __iomem *base;
+};
+
+struct acpm_rx_data {
+	u32 *cmd;
+	size_t cmdcnt;
+	size_t rxcnt;
+	bool completed;
+};
+
+#define ACPM_SEQNUM_MAX    64
+
+struct acpm_chan {
+	struct mbox_client cl;
+	struct mbox_chan *chan;
+	struct acpm_info *acpm;
+	struct acpm_queue tx;
+	struct acpm_queue rx;
+	spinlock_t tx_lock;
+	spinlock_t rx_lock;
+
+	unsigned int qlen;
+	unsigned int mlen;
+	u8 seqnum;
+	u8 id;
+	bool poll_completion;
+
+	DECLARE_BITMAP(bitmap_seqnum, ACPM_SEQNUM_MAX - 1);
+	struct acpm_rx_data rx_data[ACPM_SEQNUM_MAX];
+};
+
+struct acpm_info {
+	struct acpm_shmem __iomem *shmem;
+	void __iomem *sram_base;
+	void __iomem *mbox_intr;
+	struct acpm_chan *chans;
+	struct device *dev;
+	struct acpm_handle handle;
+	u32 num_chans;
+	atomic_t shutting_down;
+};
+
+struct acpm_match_data {
+	loff_t initdata_base;
+	const char *acpm_clk_dev_name;
+	bool manage_s2mps19_wtsr_smpl;
+};
+
+#define client_to_acpm_chan(c) container_of(c, struct acpm_chan, cl)
+#define handle_to_acpm_info(h) container_of(h, struct acpm_info, handle)
+
+static bool acpm_spin_lock_acquire(spinlock_t *lock, unsigned long *flags,
+				   bool shutdown_path)
+{
+	u64 deadline;
+
+	if (!shutdown_path) {
+		spin_lock_irqsave(lock, *flags);
+		return true;
+	}
+
+	/*
+	 * During SYS_OFF_MODE_POWER_OFF, acpm_power_off_prepare() has already
+	 * set shutting_down=1 and drained all channel locks before
+	 * smp_send_stop(). Use bounded trylock as defense-in-depth so an
+	 * abnormal direct machine_power_off() can never deadlock.
+	 */
+	deadline = ktime_get_mono_fast_ns() +
+		   (u64)ACPM_SHUTDOWN_LOCK_TIMEOUT_US * NSEC_PER_USEC;
+	do {
+		if (spin_trylock_irqsave(lock, *flags))
+			return true;
+		udelay(20);
+	} while (ktime_get_mono_fast_ns() < deadline);
+
+	return false;
+}
+
+static void acpm_get_saved_rx(struct acpm_chan *achan,
+			      const struct acpm_xfer *xfer, u32 tx_seqnum)
+{
+	const struct acpm_rx_data *rx_data = &achan->rx_data[tx_seqnum - 1];
+	u32 rx_seqnum;
+
+	if (!rx_data->rxcnt)
+		return;
+
+	rx_seqnum = FIELD_GET(ACPM_PROTOCOL_SEQNUM, rx_data->cmd[0]);
+
+	if (rx_seqnum == tx_seqnum)
+		memcpy(xfer->rxd, rx_data->cmd, xfer->rxcnt * sizeof(*xfer->rxd));
+}
+
+static int acpm_get_rx(struct acpm_chan *achan, const struct acpm_xfer *xfer,
+		       bool *native_match, bool shutdown_path)
+{
+	u32 rx_front, rx_seqnum, tx_seqnum, seqnum;
+	const void __iomem *base, *addr;
+	struct acpm_rx_data *rx_data;
+	unsigned long flags;
+	u32 i, val, mlen;
+	int ret = 0;
+
+	*native_match = false;
+
+	if (!acpm_spin_lock_acquire(&achan->rx_lock, &flags, shutdown_path))
+		return -EBUSY;
+
+	rx_front = readl(achan->rx.front);
+	i = readl(achan->rx.rear);
+
+	tx_seqnum = FIELD_GET(ACPM_PROTOCOL_SEQNUM, xfer->txd[0]);
+
+	if (i == rx_front)
+		goto out_unlock;
+
+	base = achan->rx.base;
+	mlen = achan->mlen;
+
+	/* Drain RX queue. */
+	do {
+		addr = base + mlen * i;
+		val = readl(addr);
+
+		rx_seqnum = FIELD_GET(ACPM_PROTOCOL_SEQNUM, val);
+		if (!rx_seqnum || rx_seqnum > ACPM_SEQNUM_MAX) {
+			ret = -EIO;
+			goto out_unlock;
+		}
+
+		seqnum = rx_seqnum - 1;
+		rx_data = &achan->rx_data[seqnum];
+
+		if (rx_data->rxcnt) {
+			if (rx_seqnum == tx_seqnum) {
+				__ioread32_copy(xfer->rxd, addr, xfer->rxcnt);
+				smp_store_release(&rx_data->completed, true);
+				*native_match = true;
+			} else {
+				__ioread32_copy(rx_data->cmd, addr,
+						rx_data->rxcnt);
+				smp_store_release(&rx_data->completed, true);
+			}
+		} else {
+			smp_store_release(&rx_data->completed, true);
+			if (rx_seqnum == tx_seqnum)
+				*native_match = true;
+		}
+
+		i = (i + 1) % achan->qlen;
+	} while (i != rx_front);
+
+	/* We saved all responses, mark RX empty. */
+	writel(rx_front, achan->rx.rear);
+
+out_unlock:
+	spin_unlock_irqrestore(&achan->rx_lock, flags);
+	return ret;
+}
+
+static int acpm_dequeue_by_polling(struct acpm_chan *achan,
+				   const struct acpm_xfer *xfer,
+				   bool shutdown_path)
+{
+	struct device *dev = achan->acpm->dev;
+	bool native_match;
+	u64 deadline;
+	u32 seqnum;
+	int ret;
+
+	seqnum = FIELD_GET(ACPM_PROTOCOL_SEQNUM, xfer->txd[0]);
+
+	deadline = ktime_get_mono_fast_ns() +
+		   (u64)ACPM_POLL_TIMEOUT_US * NSEC_PER_USEC;
+	do {
+		ret = acpm_get_rx(achan, xfer, &native_match, shutdown_path);
+		if (ret) {
+			clear_bit_unlock(seqnum - 1, achan->bitmap_seqnum);
+			return ret;
+		}
+
+		if (smp_load_acquire(&achan->rx_data[seqnum - 1].completed)) {
+			if (!native_match)
+				acpm_get_saved_rx(achan, xfer, seqnum);
+
+			clear_bit_unlock(seqnum - 1, achan->bitmap_seqnum);
+			return 0;
+		}
+
+		udelay(20);
+	} while (ktime_get_mono_fast_ns() < deadline);
+
+	clear_bit_unlock(seqnum - 1, achan->bitmap_seqnum);
+	dev_err(dev, "Timeout! ch:%u s:%u bitmap:%lx.\n",
+		achan->id, seqnum, achan->bitmap_seqnum[0]);
+
+	return -ETIME;
+}
+
+static int acpm_wait_for_queue_slots(struct acpm_chan *achan, u32 next_tx_front)
+{
+	u32 val;
+	int ret;
+
+	/*
+	 * Use atomic polling so TX slot waits never sleep and remain safe
+	 * while holding tx_lock spinlock and during IRQ-disabled shutdown.
+	 */
+	ret = readl_poll_timeout_atomic(achan->rx.front, val,
+					next_tx_front != val, 10,
+					ACPM_TX_TIMEOUT_US);
+	if (ret) {
+		dev_err(achan->acpm->dev, "RX front can not keep up with TX front.\n");
+		return ret;
+	}
+
+	ret = readl_poll_timeout_atomic(achan->tx.rear, val,
+					next_tx_front != val, 10,
+					ACPM_TX_TIMEOUT_US);
+	if (ret)
+		dev_err(achan->acpm->dev, "TX queue is full.\n");
+
+	return ret;
+}
+
+static int acpm_prepare_xfer(struct acpm_chan *achan,
+			     const struct acpm_xfer *xfer)
+{
+	struct acpm_rx_data *rx_data;
+	u32 *txd = (u32 *)xfer->txd;
+	unsigned long size = ACPM_SEQNUM_MAX - 1;
+	unsigned long bit = achan->seqnum;
+
+	bit = find_next_zero_bit(achan->bitmap_seqnum, size, bit);
+	if (bit >= size) {
+		bit = find_first_zero_bit(achan->bitmap_seqnum, size);
+		if (bit >= size) {
+			dev_err_ratelimited(achan->acpm->dev,
+					    "ACPM sequence number pool exhausted\n");
+			return -EBUSY;
+		}
+	}
+
+	if (WARN_ON_ONCE(test_and_set_bit_lock(bit, achan->bitmap_seqnum)))
+		return -EIO;
+
+	/* Flag the index based on seqnum. (seqnum: 1~63, bitmap: 0~62) */
+	achan->seqnum = bit + 1;
+	txd[0] |= FIELD_PREP(ACPM_PROTOCOL_SEQNUM, achan->seqnum);
+
+	rx_data = &achan->rx_data[bit];
+	rx_data->completed = false;
+	memset(rx_data->cmd, 0, sizeof(*rx_data->cmd) * rx_data->cmdcnt);
+	rx_data->rxcnt = xfer->rxcnt;
+
+	return 0;
+}
+
+static int acpm_wait_for_message_response(struct acpm_chan *achan,
+					  const struct acpm_xfer *xfer,
+					  bool shutdown_path)
+{
+	return acpm_dequeue_by_polling(achan, xfer, shutdown_path);
+}
+
+static int acpm_wait_for_singleslot_response(struct acpm_chan *achan,
+					     const struct acpm_xfer *xfer)
+{
+	struct acpm_info *acpm = achan->acpm;
+	u32 seqnum = FIELD_GET(ACPM_PROTOCOL_SEQNUM, xfer->txd[0]);
+	u32 val;
+	int ret;
+
+	if (!acpm->mbox_intr) {
+		clear_bit_unlock(seqnum - 1, achan->bitmap_seqnum);
+		return -ENODEV;
+	}
+
+	ret = readl_poll_timeout_atomic(acpm->mbox_intr + ACPM_MBOX_INTSR1, val,
+					val & (1u << achan->id), 20,
+					ACPM_POLL_TIMEOUT_US);
+	if (!ret && xfer->rxcnt && xfer->rxd)
+		memcpy_fromio(xfer->rxd, achan->rx.base,
+			      xfer->rxcnt * sizeof(*xfer->rxd));
+
+	writel(1u << achan->id, acpm->mbox_intr + ACPM_MBOX_INTCR1);
+	clear_bit_unlock(seqnum - 1, achan->bitmap_seqnum);
+	return ret;
+}
+
+static int __acpm_do_xfer(struct acpm_handle *handle,
+			  const struct acpm_xfer *xfer, bool shutdown_path)
+{
+	struct acpm_info *acpm = handle_to_acpm_info(handle);
+	struct exynos_mbox_msg msg;
+	struct acpm_chan *achan;
+	unsigned long flags;
+	u32 idx, tx_front, seqnum;
+	int ret;
+
+	if (!shutdown_path && atomic_read(&acpm->shutting_down))
+		return -ESHUTDOWN;
+
+	if (xfer->acpm_chan_id >= acpm->num_chans)
+		return -EINVAL;
+
+	achan = &acpm->chans[xfer->acpm_chan_id];
+
+	if (!xfer->txd ||
+	    (xfer->txcnt * sizeof(*xfer->txd) > achan->mlen) ||
+	    (xfer->rxcnt * sizeof(*xfer->rxd) > achan->mlen))
+		return -EINVAL;
+
+	if (!achan->poll_completion)
+		dev_dbg(achan->acpm->dev,
+			"polling interrupt-mode ACPM channel %u\n",
+			xfer->acpm_chan_id);
+
+	msg.chan_id = xfer->acpm_chan_id;
+	msg.chan_type = EXYNOS_MBOX_CHAN_TYPE_DOORBELL;
+
+	if (!acpm_spin_lock_acquire(&achan->tx_lock, &flags, shutdown_path))
+		return -EBUSY;
+
+	if (!shutdown_path && atomic_read(&acpm->shutting_down)) {
+		spin_unlock_irqrestore(&achan->tx_lock, flags);
+		return -ESHUTDOWN;
+	}
+
+	tx_front = readl(achan->tx.front);
+	idx = (tx_front + 1) % achan->qlen;
+
+	if (achan->qlen > 1) {
+		ret = acpm_wait_for_queue_slots(achan, idx);
+		if (ret) {
+			spin_unlock_irqrestore(&achan->tx_lock, flags);
+			return ret;
+		}
+	}
+
+	ret = acpm_prepare_xfer(achan, xfer);
+	if (ret) {
+		spin_unlock_irqrestore(&achan->tx_lock, flags);
+		return ret;
+	}
+	seqnum = achan->seqnum;
+
+	__iowrite32_copy(achan->tx.base + achan->mlen * tx_front,
+			 xfer->txd, xfer->txcnt);
+	writel(idx, achan->tx.front);
+
+	ret = mbox_send_message(achan->chan, (void *)&msg);
+	if (ret < 0) {
+		clear_bit_unlock(seqnum - 1, achan->bitmap_seqnum);
+		spin_unlock_irqrestore(&achan->tx_lock, flags);
+		return ret;
+	}
+
+	mbox_client_txdone(achan->chan, 0);
+	spin_unlock_irqrestore(&achan->tx_lock, flags);
+
+	if (achan->qlen == 1)
+		return acpm_wait_for_singleslot_response(achan, xfer);
+
+	return acpm_wait_for_message_response(achan, xfer, shutdown_path);
+}
+
+int acpm_do_xfer(struct acpm_handle *handle, const struct acpm_xfer *xfer)
+{
+	return __acpm_do_xfer(handle, xfer, false);
+}
+
+int acpm_do_xfer_shutdown(struct acpm_handle *handle,
+			  const struct acpm_xfer *xfer)
+{
+	return __acpm_do_xfer(handle, xfer, true);
+}
+
+void acpm_set_xfer(struct acpm_xfer *xfer, u32 *cmd, size_t cmdcnt,
+		   unsigned int acpm_chan_id, bool response)
+{
+	xfer->acpm_chan_id = acpm_chan_id;
+	xfer->txcnt = cmdcnt;
+	xfer->txd = cmd;
+
+	if (response) {
+		xfer->rxcnt = cmdcnt;
+		xfer->rxd = cmd;
+	} else {
+		xfer->rxcnt = 0;
+		xfer->rxd = NULL;
+	}
+}
+
+static void acpm_chan_shmem_get_params(struct acpm_chan *achan,
+				struct acpm_chan_shmem __iomem *chan_shmem)
+{
+	void __iomem *base = achan->acpm->sram_base;
+	struct acpm_queue *rx = &achan->rx;
+	struct acpm_queue *tx = &achan->tx;
+
+	achan->mlen = readl(&chan_shmem->mlen);
+	achan->poll_completion = readl(&chan_shmem->poll_completion);
+	achan->id = readl(&chan_shmem->id);
+	achan->qlen = readl(&chan_shmem->qlen);
+
+	tx->base = base + readl(&chan_shmem->rx_base);
+	tx->rear = base + readl(&chan_shmem->rx_rear);
+	tx->front = base + readl(&chan_shmem->rx_front);
+
+	rx->base = base + readl(&chan_shmem->tx_base);
+	rx->rear = base + readl(&chan_shmem->tx_rear);
+	rx->front = base + readl(&chan_shmem->tx_front);
+
+	dev_info(achan->acpm->dev,
+		 "acpm chan idx=%d id=%d poll=%d mlen=%d qlen=%d\n",
+		 (int)(achan - achan->acpm->chans), achan->id,
+		 achan->poll_completion, achan->mlen, achan->qlen);
+}
+
+static int acpm_achan_alloc_cmds(struct acpm_chan *achan)
+{
+	struct device *dev = achan->acpm->dev;
+	struct acpm_rx_data *rx_data;
+	size_t cmd_size, cmdcnt;
+	int i;
+
+	if (achan->mlen == 0)
+		return 0;
+
+	cmd_size = sizeof(*(achan->rx_data[0].cmd));
+	cmdcnt = DIV_ROUND_UP_ULL(achan->mlen, cmd_size);
+
+	for (i = 0; i < ACPM_SEQNUM_MAX; i++) {
+		rx_data = &achan->rx_data[i];
+		rx_data->cmdcnt = cmdcnt;
+		rx_data->cmd = devm_kcalloc(dev, cmdcnt, cmd_size, GFP_KERNEL);
+		if (!rx_data->cmd)
+			return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static void acpm_free_mbox_chans(void *data)
+{
+	struct acpm_info *acpm = data;
+	int i;
+
+	for (i = 0; i < acpm->num_chans; i++)
+		if (!IS_ERR_OR_NULL(acpm->chans[i].chan))
+			mbox_free_channel(acpm->chans[i].chan);
+}
+
+static int acpm_channels_init(struct acpm_info *acpm)
+{
+	struct acpm_shmem __iomem *shmem = acpm->shmem;
+	struct acpm_chan_shmem __iomem *chans_shmem;
+	struct device *dev = acpm->dev;
+	int i, ret;
+
+	acpm->num_chans = readl(&shmem->num_chans);
+	acpm->chans = devm_kcalloc(dev, acpm->num_chans, sizeof(*acpm->chans),
+				   GFP_KERNEL);
+	if (!acpm->chans)
+		return -ENOMEM;
+
+	ret = devm_add_action_or_reset(dev, acpm_free_mbox_chans, acpm);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to add mbox free action.\n");
+
+	chans_shmem = acpm->sram_base + readl(&shmem->chans);
+
+	for (i = 0; i < acpm->num_chans; i++) {
+		struct acpm_chan_shmem __iomem *chan_shmem = &chans_shmem[i];
+		struct acpm_chan *achan = &acpm->chans[i];
+		struct mbox_client *cl = &achan->cl;
+
+		achan->acpm = acpm;
+
+		acpm_chan_shmem_get_params(achan, chan_shmem);
+
+		ret = acpm_achan_alloc_cmds(achan);
+		if (ret)
+			return ret;
+
+		spin_lock_init(&achan->rx_lock);
+		spin_lock_init(&achan->tx_lock);
+
+		cl->dev = dev;
+
+		achan->chan = mbox_request_channel(cl, 0);
+		if (IS_ERR(achan->chan))
+			return PTR_ERR(achan->chan);
+	}
+
+	return 0;
+}
+
+static void acpm_clk_pdev_unregister(void *data)
+{
+	platform_device_unregister(data);
+}
