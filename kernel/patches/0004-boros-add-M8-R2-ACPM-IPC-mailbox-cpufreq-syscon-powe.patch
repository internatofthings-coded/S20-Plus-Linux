+/*
+ * Exynos990 / SM-G985F (y2s) S2MPS19 RTC WTSR/SMPL management:
+ * Verified against y2s-original.dts (s2mps19mfd@00):
+ *   acpm-ipc-channel = <2>, acpm-speedy-channel = <0>,
+ *   wtsr_en = "enabled", smpl_en = "enabled",
+ *   wtsr_timer_val = <0x03>, smpl_timer_val = <0x02>.
+ *
+ * RTC reg 0x01 bit layout (include/linux/mfd/samsung/rtc.h):
+ *   bit 7: SMPL_EN, bit 6: WTSR_EN, bits [5:3]: SMPL_TIMER, bits [2:0]: WTSR_TIMER.
+ * Default fallback timer bits (0x23 -> 0xe3 with EN bits set) used ONLY if
+ * reg 0x01 was completely zeroed by total battery POR; otherwise existing
+ * S-Boot timer bits [5:0] are strictly preserved.
+ */
+#define S2MPS19_ACPM_CHAN		2	/* acpm-ipc-channel (firmware id 2) */
+#define S2MPS19_SPEEDY_CHAN		0	/* main PMIC speedy channel */
+#define S2MPS19_TYPE_RTC		0x02	/* S2MPS19 RTC sub-block address */
+#define S2MP_RTC_REG_WTSR_SMPL		0x01	/* WTSR_EN=bit6 SMPL_EN=bit7 */
+#define S2MP_RTC_WTSR_EN		BIT(6)
+#define S2MP_RTC_SMPL_EN		BIT(7)
+#define S2MP_RTC_WTSR_SMPL_EN		(S2MP_RTC_WTSR_EN | S2MP_RTC_SMPL_EN)
+#define S2MP_RTC_WTSR_SMPL_TIMER_MASK	GENMASK(5, 0)
+#define S2MP_RTC_WTSR_SMPL_DEFAULT_TMR	0x23	/* 0x23 | 0xc0 = 0xe3 */
+
+static void s2mps19_enable_wtsr_smpl(struct acpm_info *acpm)
+{
+	u8 val = 0, target, after = 0;
+	int ret;
+
+	ret = acpm_pmic_read_reg(&acpm->handle, S2MPS19_ACPM_CHAN,
+				 S2MPS19_TYPE_RTC, S2MP_RTC_REG_WTSR_SMPL,
+				 S2MPS19_SPEEDY_CHAN, &val);
+	if (ret) {
+		dev_warn(acpm->dev, "ACPM: boot WTSR_SMPL read failed (%d)\n", ret);
+		return;
+	}
+
+	dev_info(acpm->dev,
+		 "ACPM: boot RTC WTSR_SMPL=0x%02x (WTSR_EN=%u SMPL_EN=%u timers=0x%02x)\n",
+		 val, !!(val & S2MP_RTC_WTSR_EN), !!(val & S2MP_RTC_SMPL_EN),
+		 (unsigned int)(val & S2MP_RTC_WTSR_SMPL_TIMER_MASK));
+
+	if ((val & S2MP_RTC_WTSR_SMPL_EN) == S2MP_RTC_WTSR_SMPL_EN &&
+	    (val & S2MP_RTC_WTSR_SMPL_TIMER_MASK) != 0) {
+		dev_info(acpm->dev, "ACPM: WTSR/SMPL already armed at boot\n");
+		return;
+	}
+
+	if (val & S2MP_RTC_WTSR_SMPL_TIMER_MASK)
+		target = val | S2MP_RTC_WTSR_SMPL_EN;
+	else
+		target = S2MP_RTC_WTSR_SMPL_DEFAULT_TMR | S2MP_RTC_WTSR_SMPL_EN;
+
+	ret = acpm_pmic_write_reg(&acpm->handle, S2MPS19_ACPM_CHAN,
+				  S2MPS19_TYPE_RTC, S2MP_RTC_REG_WTSR_SMPL,
+				  S2MPS19_SPEEDY_CHAN, target);
+	if (ret) {
+		dev_err(acpm->dev, "ACPM: boot WTSR_SMPL re-arm write 0x%02x failed (%d)\n",
+			target, ret);
+		return;
+	}
+
+	ret = acpm_pmic_read_reg(&acpm->handle, S2MPS19_ACPM_CHAN,
+				 S2MPS19_TYPE_RTC, S2MP_RTC_REG_WTSR_SMPL,
+				 S2MPS19_SPEEDY_CHAN, &after);
+	if (ret || (after & S2MP_RTC_WTSR_SMPL_EN) != S2MP_RTC_WTSR_SMPL_EN) {
+		dev_err(acpm->dev,
+			"ACPM: boot WTSR_SMPL verify mismatch (wrote=0x%02x read=0x%02x ret=%d)\n",
+			target, after, ret);
+		return;
+	}
+
+	dev_info(acpm->dev, "ACPM: WTSR/SMPL re-armed at boot (0x%02x -> 0x%02x)\n",
+		 val, after);
+}
+
+static void s2mps19_disable_wtsr_smpl(struct acpm_info *acpm)
+{
+	u8 val = 0, target, after = 0;
+	int ret;
+
+	ret = acpm_pmic_read_reg_shutdown(&acpm->handle, S2MPS19_ACPM_CHAN,
+					  S2MPS19_TYPE_RTC, S2MP_RTC_REG_WTSR_SMPL,
+					  S2MPS19_SPEEDY_CHAN, &val);
+	if (ret) {
+		dev_emerg(acpm->dev, "ACPM: WTSR_SMPL read failed (%d)\n", ret);
+		return;
+	}
+
+	dev_emerg(acpm->dev, "ACPM: RTC WTSR_SMPL=0x%02x before power off\n", val);
+
+	if (!(val & S2MP_RTC_WTSR_SMPL_EN))
+		return;	/* already disarmed */
+
+	target = val & ~S2MP_RTC_WTSR_SMPL_EN;
+	ret = acpm_pmic_write_reg_shutdown(&acpm->handle, S2MPS19_ACPM_CHAN,
+					   S2MPS19_TYPE_RTC, S2MP_RTC_REG_WTSR_SMPL,
+					   S2MPS19_SPEEDY_CHAN, target);
+	if (ret) {
+		dev_emerg(acpm->dev, "ACPM: WTSR_SMPL clear failed (%d)\n", ret);
+		return;
+	}
+
+	ret = acpm_pmic_read_reg_shutdown(&acpm->handle, S2MPS19_ACPM_CHAN,
+					  S2MPS19_TYPE_RTC, S2MP_RTC_REG_WTSR_SMPL,
+					  S2MPS19_SPEEDY_CHAN, &after);
+	dev_emerg(acpm->dev, "ACPM: WTSR_SMPL cleared, readback=0x%02x (ret=%d)\n",
+		  after, ret);
+}
+
+#define ACPM_IPC_PROTOCOL_STOP		22
+#define ACPM_POWEROFF_CHAN_ID		4	/* samsung,exynos-acpm framework channel id */
+
+static int acpm_enter_wfi(struct acpm_info *acpm)
+{
+	u32 cmd[4] = { BIT(ACPM_IPC_PROTOCOL_STOP) };
+	struct acpm_xfer xfer;
+	unsigned int i, cnt;
+	int idx = -1;
+
+	/* Select the framework channel by firmware id, not array index. */
+	for (i = 0; i < acpm->num_chans; i++) {
+		if (acpm->chans[i].id == ACPM_POWEROFF_CHAN_ID) {
+			idx = i;
+			break;
+		}
+	}
+	if (idx < 0)
+		return -ENODEV;
+
+	cnt = ARRAY_SIZE(cmd);
+	if (cnt > acpm->chans[idx].mlen / sizeof(u32))
+		cnt = acpm->chans[idx].mlen / sizeof(u32);
+	if (!cnt)
+		return -EINVAL;
+
+	dev_emerg(acpm->dev, "ACPM: STOP on chan idx=%d id=%d cnt=%u\n",
+		  idx, ACPM_POWEROFF_CHAN_ID, cnt);
+	acpm_set_xfer(&xfer, cmd, cnt, idx, true);
+	return acpm_do_xfer_shutdown(&acpm->handle, &xfer);
+}
+
+/*
+ * Runs in process context with IRQs enabled BEFORE migrate_to_reboot_cpu()
+ * and smp_send_stop(). Quiesces all non-shutdown ACPM callers and drains
+ * every channel's tx_lock and rx_lock so no stopped CPU can hold a lock
+ * when acpm_power_off_notify() runs in IRQ-disabled atomic context.
+ */
+static int acpm_power_off_prepare(struct sys_off_data *data)
+{
+	struct acpm_info *acpm = data->cb_data;
+	unsigned long flags;
+	unsigned int i;
+
+	atomic_set(&acpm->shutting_down, 1);
+	smp_mb();
+
+	for (i = 0; i < acpm->num_chans; i++) {
+		spin_lock_irqsave(&acpm->chans[i].tx_lock, flags);
+		spin_unlock_irqrestore(&acpm->chans[i].tx_lock, flags);
+
+		spin_lock_irqsave(&acpm->chans[i].rx_lock, flags);
+		spin_unlock_irqrestore(&acpm->chans[i].rx_lock, flags);
+	}
+
+	dev_info(acpm->dev, "ACPM: power-off prepare quiesced %u channels\n",
+		 acpm->num_chans);
+	return NOTIFY_DONE;
+}
+
+static int acpm_power_off_notify(struct sys_off_data *data)
+{
+	struct acpm_info *acpm = data->cb_data;
+	int ret;
+
+	/* Ensure normal callers are blocked even if prepare was bypassed. */
+	atomic_set(&acpm->shutting_down, 1);
+
+	/*
+	 * Disarm the PMIC WTSR/SMPL watchdog first, while the APM is still
+	 * alive to service the PMIC channel.
+	 */
+	s2mps19_disable_wtsr_smpl(acpm);
+
+	dev_emerg(acpm->dev, "ACPM: halting APM before power off\n");
+	ret = acpm_enter_wfi(acpm);
+	if (ret)
+		dev_emerg(acpm->dev, "ACPM: enter WFI failed (%d)\n", ret);
+
+	/* DONE so syscon-poweroff runs next (prio 192 < 224) and drops PS_HOLD. */
+	return NOTIFY_DONE;
+}
+
+static int acpm_probe(struct platform_device *pdev)
+{
+	const struct acpm_match_data *match_data;
+	struct platform_device *acpm_clk_pdev;
+	struct device *dev = &pdev->dev;
+	struct device_node *shmem;
+	struct acpm_info *acpm;
+	resource_size_t size;
+	struct resource res;
+	int ret;
+
+	acpm = devm_kzalloc(dev, sizeof(*acpm), GFP_KERNEL);
+	if (!acpm)
+		return -ENOMEM;
+
+	atomic_set(&acpm->shutting_down, 0);
+
+	shmem = of_parse_phandle(dev->of_node, "shmem", 0);
+	ret = of_address_to_resource(shmem, 0, &res);
+	of_node_put(shmem);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "Failed to get shared memory.\n");
+
+	size = resource_size(&res);
+	acpm->sram_base = devm_ioremap(dev, res.start, size);
+	if (!acpm->sram_base)
+		return dev_err_probe(dev, -ENOMEM,
+				     "Failed to ioremap shared memory.\n");
+
+	match_data = of_device_get_match_data(dev);
+	if (!match_data)
+		return dev_err_probe(dev, -EINVAL,
+				     "Failed to get match data.\n");
+
+	acpm->shmem = acpm->sram_base + match_data->initdata_base;
+	acpm->dev = dev;
+
+	{
+		struct device_node *mbox_np =
+			of_parse_phandle(dev->of_node, "mboxes", 0);
+
+		if (mbox_np) {
+			acpm->mbox_intr = of_iomap(mbox_np, 0);
+			of_node_put(mbox_np);
+		}
+	}
+
+	ret = acpm_channels_init(acpm);
+	if (ret)
+		return ret;
+
+	acpm->handle.ops = &exynos_acpm_driver_ops;
+
+	platform_set_drvdata(pdev, acpm);
+
+	if (match_data->manage_s2mps19_wtsr_smpl)
+		s2mps19_enable_wtsr_smpl(acpm);
+
+	if (match_data->acpm_clk_dev_name) {
+		acpm_clk_pdev = platform_device_register_data(dev,
+						match_data->acpm_clk_dev_name,
+						PLATFORM_DEVID_NONE, NULL, 0);
+		if (IS_ERR(acpm_clk_pdev))
+			return dev_err_probe(dev, PTR_ERR(acpm_clk_pdev),
+				     "Failed to register ACPM clocks device.\n");
+
+		ret = devm_add_action_or_reset(dev, acpm_clk_pdev_unregister,
+				       acpm_clk_pdev);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to add devm action.\n");
+	}
+
+	if (match_data->manage_s2mps19_wtsr_smpl) {
+		ret = devm_register_sys_off_handler(dev,
+						    SYS_OFF_MODE_POWER_OFF_PREPARE,
+						    SYS_OFF_PRIO_FIRMWARE,
+						    acpm_power_off_prepare,
+						    acpm);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "Failed to register power-off prepare handler.\n");
+
+		ret = devm_register_sys_off_handler(dev,
+						    SYS_OFF_MODE_POWER_OFF,
+						    SYS_OFF_PRIO_FIRMWARE,
+						    acpm_power_off_notify,
+						    acpm);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "Failed to register power-off handler.\n");
+	}
+
+	return devm_of_platform_populate(dev);
+}
+
+static void acpm_handle_put(struct acpm_handle *handle)
+{
+	struct acpm_info *acpm = handle_to_acpm_info(handle);
+	struct device *dev = acpm->dev;
+
+	module_put(dev->driver->owner);
+	put_device(dev);
+}
+
+static void devm_acpm_release(struct device *dev, void *res)
+{
+	acpm_handle_put(*(struct acpm_handle **)res);
+}
+
+static struct acpm_handle *acpm_get_by_node(struct device *dev,
+					    struct device_node *np)
+{
+	struct platform_device *pdev;
+	struct device_link *link;
+	struct acpm_info *acpm;
+
+	pdev = of_find_device_by_node(np);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	acpm = platform_get_drvdata(pdev);
+	if (!acpm) {
+		platform_device_put(pdev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
+	if (!try_module_get(pdev->dev.driver->owner)) {
+		platform_device_put(pdev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
+	link = device_link_add(dev, &pdev->dev, DL_FLAG_AUTOREMOVE_SUPPLIER);
+	if (!link) {
+		dev_err(&pdev->dev,
+			"Failed to create device link to consumer %s.\n",
+			dev_name(dev));
+		platform_device_put(pdev);
+		module_put(pdev->dev.driver->owner);
+		return ERR_PTR(-EINVAL);
+	}
+
+	return &acpm->handle;
+}
+
+struct acpm_handle *devm_acpm_get_by_node(struct device *dev,
+					  struct device_node *np)
+{
+	struct acpm_handle **ptr, *handle;
+
+	ptr = devres_alloc(devm_acpm_release, sizeof(*ptr), GFP_KERNEL);
+	if (!ptr)
+		return ERR_PTR(-ENOMEM);
+
+	handle = acpm_get_by_node(dev, np);
+	if (!IS_ERR(handle)) {
+		*ptr = handle;
+		devres_add(dev, ptr);
+	} else {
+		devres_free(ptr);
+	}
+
+	return handle;
+}
+EXPORT_SYMBOL_GPL(devm_acpm_get_by_node);
+
+struct acpm_handle *devm_acpm_get_by_phandle(struct device *dev)
+{
+	struct acpm_handle *handle;
+	struct device_node *np;
+
+	np = of_parse_phandle(dev->of_node, "samsung,acpm-ipc", 0);
+	if (!np)
+		return ERR_PTR(-ENODEV);
+
+	handle = devm_acpm_get_by_node(dev, np);
+	of_node_put(np);
+
+	return handle;
+}
+EXPORT_SYMBOL_GPL(devm_acpm_get_by_phandle);
