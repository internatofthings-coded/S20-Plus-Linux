diff --git a/drivers/firmware/samsung/exynos-acpm-tmu.c b/drivers/firmware/samsung/exynos-acpm-tmu.c
new file mode 100644
index 000000000..c202b4c87
--- /dev/null
+++ b/drivers/firmware/samsung/exynos-acpm-tmu.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos990 ACPM TMU IPC client (read-only temperature telemetry).
+ *
+ * Message format verified against Samsung Exynos9830/990 GPL exynos_acpm_tmu.h:
+ *   REQ  cmd[1]: type (bits 7:0), tzid (bits 23:16)
+ *   RESP rxd[1]: type (bits 7:0), ret (s8 bits 15:8), tzid (bits 23:16),
+ *                temp in integer degC (u8 bits 31:24)
+ */
+#include <linux/array_size.h>
+#include <linux/build_bug.h>
+#include <linux/errno.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/types.h>
+
+#include "exynos-acpm.h"
+#include "exynos-acpm-tmu.h"
+
+#define TMU_IPC_INIT		0x01
+#define TMU_IPC_READ_TEMP	0x02
+
+#define EXYNOS990_TMU_MAX_TZ	5
+#define EXYNOS990_TMU_MAX_DEGC	135
+
+int acpm_tmu_init(struct acpm_handle *handle, unsigned int acpm_chan_id)
+{
+	struct acpm_xfer xfer = {0};
+	u32 cmd[4] = { 0, TMU_IPC_INIT, 0, 0 };
+	s8 resp_ret;
+	int ret;
+
+	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, true);
+	ret = acpm_do_xfer(handle, &xfer);
+	if (ret)
+		return ret;
+
+	resp_ret = (s8)((xfer.rxd[1] >> 8) & 0xff);
+	if (resp_ret < 0)
+		return -EIO;
+
+	return 0;
+}
+
+int acpm_tmu_read_temp(struct acpm_handle *handle, unsigned int acpm_chan_id,
+		       u8 tz, int *temp)
+{
+	struct acpm_xfer xfer = {0};
+	u32 cmd[4] = { 0, TMU_IPC_READ_TEMP | ((u32)tz << 16), 0, 0 };
+	s8 resp_ret;
+	u8 raw_temp;
+	int ret;
+
+	if (!temp || tz > EXYNOS990_TMU_MAX_TZ)
+		return -EINVAL;
+
+	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, true);
+	ret = acpm_do_xfer(handle, &xfer);
+	if (ret)
+		return ret;
+
+	resp_ret = (s8)((xfer.rxd[1] >> 8) & 0xff);
+	if (resp_ret < 0)
+		return -EIO;
+
+	raw_temp = (xfer.rxd[1] >> 24) & 0xff;
+	/* Reject uninitialized (0 C) or implausible (>135 C) readings fail-safely */
+	if (raw_temp == 0 || raw_temp > EXYNOS990_TMU_MAX_DEGC)
+		return -EIO;
+
+	*temp = (int)raw_temp * 1000;
+	return 0;
+}
