diff --git a/drivers/thermal/samsung/exynos990_acpm_tmu.c b/drivers/thermal/samsung/exynos990_acpm_tmu.c
new file mode 100644
index 000000000..a6e6c335f
--- /dev/null
+++ b/drivers/thermal/samsung/exynos990_acpm_tmu.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos990 ACPM TMU thermal sensor driver (read-only telemetry).
+ *
+ * Reads live SoC temperatures from the APM firmware via ACPM IPC channel 9
+ * without altering hardware TMU thresholds or disabling firmware protections.
+ * Registers all 6 Exynos990 zones (BIG=0, MID=1, LITTLE=2, G3D=3, ISP=4, NPU=5)
+ * with Linux of-thermal for passive CPUFreq throttling and critical shutdown.
+ */
+#include <linux/err.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#define EXYNOS990_TMU_NUM_ZONES		6
+#define EXYNOS990_TMU_DEFAULT_CHAN	9
+
+struct exynos990_tmu;
+
+struct exynos990_tmu_sensor {
+	struct exynos990_tmu *tmu;
+	u8 tz_id;
+};
+
+struct exynos990_tmu {
+	struct device *dev;
+	struct acpm_handle *acpm;
+	u32 acpm_chan_id;
+	struct exynos990_tmu_sensor sensors[EXYNOS990_TMU_NUM_ZONES];
+};
+
+static const char * const exynos990_tmu_names[EXYNOS990_TMU_NUM_ZONES] = {
+	"BIG", "MID", "LITTLE", "G3D", "ISP", "NPU"
+};
+
+static int exynos990_tmu_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct exynos990_tmu_sensor *sensor = thermal_zone_device_priv(tz);
+	struct exynos990_tmu *tmu = sensor->tmu;
+
+	return tmu->acpm->ops->tmu.read_temp(tmu->acpm, tmu->acpm_chan_id,
+					     sensor->tz_id, temp);
+}
+
+static const struct thermal_zone_device_ops exynos990_tmu_ops = {
+	.get_temp = exynos990_tmu_get_temp,
+};
+
+static int exynos990_tmu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *acpm_np;
+	struct exynos990_tmu *tmu;
+	int ret, i, temp, registered = 0;
+
+	tmu = devm_kzalloc(dev, sizeof(*tmu), GFP_KERNEL);
+	if (!tmu)
+		return -ENOMEM;
+
+	tmu->dev = dev;
+	tmu->acpm_chan_id = EXYNOS990_TMU_DEFAULT_CHAN;
+	of_property_read_u32(dev->of_node, "samsung,acpm-ipc-channel",
+			     &tmu->acpm_chan_id);
+
+	acpm_np = of_find_compatible_node(NULL, NULL, "samsung,exynos990-acpm-ipc");
+	if (!acpm_np)
+		return -ENODEV;
+
+	tmu->acpm = devm_acpm_get_by_node(dev, acpm_np);
+	of_node_put(acpm_np);
+	if (IS_ERR(tmu->acpm))
+		return dev_err_probe(dev, PTR_ERR(tmu->acpm),
+				     "waiting for ACPM provider\n");
+
+	if (!tmu->acpm->ops || !tmu->acpm->ops->tmu.init ||
+	    !tmu->acpm->ops->tmu.read_temp)
+		return -EOPNOTSUPP;
+
+	ret = tmu->acpm->ops->tmu.init(tmu->acpm, tmu->acpm_chan_id);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "ACPM TMU init failed on ch %u\n",
+				     tmu->acpm_chan_id);
+
+	for (i = 0; i < EXYNOS990_TMU_NUM_ZONES; i++) {
+		struct thermal_zone_device *tzd;
+
+		tmu->sensors[i].tmu = tmu;
+		tmu->sensors[i].tz_id = i;
+
+		tzd = devm_thermal_of_zone_register(dev, i, &tmu->sensors[i],
+						    &exynos990_tmu_ops);
+		if (IS_ERR(tzd)) {
+			ret = PTR_ERR(tzd);
+			if (ret == -ENODEV)
+				continue;
+			dev_warn(dev, "zone %d (%s) register failed: %d\n",
+				 i, exynos990_tmu_names[i], ret);
+			continue;
+		}
+		registered++;
+
+		if (!exynos990_tmu_get_temp(tzd, &temp))
+			dev_info(dev, "zone %d (%s): %d.%d C\n",
+				 i, exynos990_tmu_names[i],
+				 temp / 1000, (temp % 1000) / 100);
+		else
+			dev_warn(dev, "zone %d (%s): initial read failed\n",
+				 i, exynos990_tmu_names[i]);
+	}
+
+	if (!registered)
+		return dev_err_probe(dev, -ENODEV, "no thermal zones registered\n");
+
+	dev_info(dev, "registered %d Exynos990 ACPM TMU thermal zones (ch %u)\n",
+		 registered, tmu->acpm_chan_id);
+	return 0;
+}
+
+static const struct of_device_id exynos990_tmu_of_match[] = {
+	{ .compatible = "samsung,exynos990-acpm-tmu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos990_tmu_of_match);
+
+static struct platform_driver exynos990_tmu_driver = {
+	.probe = exynos990_tmu_probe,
+	.driver = {
+		.name = "exynos990-acpm-tmu",
+		.of_match_table = exynos990_tmu_of_match,
+	},
+};
+module_platform_driver(exynos990_tmu_driver);
+
+MODULE_DESCRIPTION("Exynos990 ACPM TMU thermal driver");
+MODULE_LICENSE("GPL");
-- 
