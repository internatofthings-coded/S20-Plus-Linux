From 7a31c1872b609de0725bbc81c600b04ae6793b3c Mon Sep 17 00:00:00 2001
From: Boros Maintainer <boros@local>
Date: Tue, 24 Nov 2026 16:32:36 +0800
Subject: [PATCH 12/13] cpufreq: exynos990: serialize DVFS, enforce MIF-safe
 ceilings, and use FREQ_QOS_MIN for boot floor

---
 drivers/cpufreq/exynos990-cpufreq.c | 130 +++++++++++++++++++++++++---
 1 file changed, 117 insertions(+), 13 deletions(-)

diff --git a/drivers/cpufreq/exynos990-cpufreq.c b/drivers/cpufreq/exynos990-cpufreq.c
index b8ca499f9..98e8d2d2d 100644
--- a/drivers/cpufreq/exynos990-cpufreq.c
+++ b/drivers/cpufreq/exynos990-cpufreq.c
@@ -13,13 +13,18 @@
 #include <linux/err.h>
 #include <linux/firmware/samsung/exynos-acpm-protocol.h>
 #include <linux/init.h>
+#include <linux/jiffies.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/pm_qos.h>
 #include <linux/slab.h>
 #include <linux/units.h>
+#include <linux/workqueue.h>
 
 #define ACPM_DVFS_CHANNEL	5
+#define Z3S_BOOT_QOS_HOLD_MS	20000
 
 struct z3s_cluster {
 	unsigned int acpm_id;		/* CPUCL0=2, CPUCL1=3, CPUCL2=4 */
@@ -27,7 +32,11 @@ struct z3s_cluster {
 	unsigned int last_cpu;
 	const unsigned int *khz;	/* ascending frequency table (kHz) */
 	unsigned int n;
+	unsigned int boot_min_khz;	/* Samsung y2s user-default-qos floor */
+	unsigned int mif_safe_max_khz;	/* Samsung y2s dm-constraints mif-perf=0 ceiling */
 	unsigned int cur_khz;
+	struct freq_qos_request boot_min_req;
+	struct delayed_work boot_qos_work;
 };
 
 static const unsigned int cl0_khz[] = {
@@ -42,14 +51,38 @@ static const unsigned int cl2_khz[] = {
 	2340000, 2548000, 2730000
 };
 
+/*
+ * Samsung y2s-original.dts cpufreq_domain0/1/2 constraints:
+ * - user-default-qos: CL0=806000 (OPP 858000), CL1=845000 (OPP 862000),
+ *   CL2=962000 (OPP 1014000).
+ * - dm-constraints mif-perf table: CL1 frequencies > 1872000 kHz and CL2
+ *   frequencies > 1898000 kHz require active MIF/bus devfreq scaling
+ *   (>= 2288000 kHz). Without an in-kernel Exynos990 MIF devfreq driver,
+ *   cap default policy.max to the MIF-independent ceiling (mif-perf == 0).
+ */
 static struct z3s_cluster clusters[] = {
-	{ 2, 0, 3, cl0_khz, ARRAY_SIZE(cl0_khz), 0 },
-	{ 3, 4, 5, cl1_khz, ARRAY_SIZE(cl1_khz), 0 },
-	{ 4, 6, 7, cl2_khz, ARRAY_SIZE(cl2_khz), 0 },
+	{ 2, 0, 3, cl0_khz, ARRAY_SIZE(cl0_khz),  858000, 2002000, 0 },
+	{ 3, 4, 5, cl1_khz, ARRAY_SIZE(cl1_khz),  862000, 1872000, 0 },
+	{ 4, 6, 7, cl2_khz, ARRAY_SIZE(cl2_khz), 1014000, 1898000, 0 },
 };
 
 static struct acpm_handle *z3s_acpm;
 static struct platform_device *z3s_pdev;
+static DEFINE_MUTEX(z3s_dvfs_lock);
+static DEFINE_MUTEX(z3s_qos_lock);
+static unsigned long z3s_boot_qos_deadline;
+
+static void z3s_boot_qos_release_work(struct work_struct *work)
+{
+	struct z3s_cluster *cl = container_of(to_delayed_work(work),
+					      struct z3s_cluster,
+					      boot_qos_work);
+
+	mutex_lock(&z3s_qos_lock);
+	if (freq_qos_request_active(&cl->boot_min_req))
+		freq_qos_remove_request(&cl->boot_min_req);
+	mutex_unlock(&z3s_qos_lock);
+}
 
 static struct z3s_cluster *cluster_for_cpu(unsigned int cpu)
 {
@@ -61,17 +94,44 @@ static struct z3s_cluster *cluster_for_cpu(unsigned int cpu)
 	return NULL;
 }
 
+static int z3s_cpufreq_verify(struct cpufreq_policy_data *policy)
+{
+	struct z3s_cluster *cl = cluster_for_cpu(policy->cpu);
+
+	if (cl) {
+		if (policy->max > cl->mif_safe_max_khz)
+			policy->max = cl->mif_safe_max_khz;
+		if (policy->min > policy->max)
+			policy->min = policy->max;
+	}
+	return cpufreq_generic_frequency_table_verify(policy);
+}
+
 static int z3s_target_index(struct cpufreq_policy *policy, unsigned int index)
 {
 	struct z3s_cluster *cl = policy->driver_data;
 	unsigned int khz = policy->freq_table[index].frequency;
 	int ret;
 
+	/*
+	 * Both MIF-safe ceilings (policy->freq_table + z3s_cpufreq_verify) and
+	 * the 20s boot floor (FREQ_QOS_MIN via z3s_cpufreq_ready) are enforced
+	 * by the Linux CPUFreq/PM-QoS core before resolving @index. Thus @khz
+	 * is always an exact valid OPP from policy->freq_table and policy->cur
+	 * never desynchronizes from cl->cur_khz.
+	 */
+	mutex_lock(&z3s_dvfs_lock);
+	if (cl->cur_khz == khz) {
+		mutex_unlock(&z3s_dvfs_lock);
+		return 0;
+	}
+
 	ret = z3s_acpm->ops->dvfs.set_rate(z3s_acpm, ACPM_DVFS_CHANNEL,
 					   cl->acpm_id,
 					   (unsigned long)khz * HZ_PER_KHZ);
 	if (!ret)
 		cl->cur_khz = khz;
+	mutex_unlock(&z3s_dvfs_lock);
 	return ret;
 }
 
@@ -81,24 +141,28 @@ static unsigned int z3s_get(unsigned int cpu)
 
 	if (!cl)
 		return 0;
-	return cl->cur_khz ? cl->cur_khz : cl->khz[cl->n - 1];
+	return cl->cur_khz ? cl->cur_khz : cl->mif_safe_max_khz;
 }
 
 static int z3s_cpufreq_init(struct cpufreq_policy *policy)
 {
 	struct z3s_cluster *cl = cluster_for_cpu(policy->cpu);
 	struct cpufreq_frequency_table *ft;
-	unsigned int i, cpu;
+	unsigned int i, n = 0, cpu;
 
 	if (!cl)
 		return -ENODEV;
 
-	ft = kcalloc(cl->n + 1, sizeof(*ft), GFP_KERNEL);
+	for (i = 0; i < cl->n; i++)
+		if (cl->khz[i] <= cl->mif_safe_max_khz)
+			n++;
+
+	ft = kcalloc(n + 1, sizeof(*ft), GFP_KERNEL);
 	if (!ft)
 		return -ENOMEM;
-	for (i = 0; i < cl->n; i++)
+	for (i = 0; i < n; i++)
 		ft[i].frequency = cl->khz[i];
-	ft[cl->n].frequency = CPUFREQ_TABLE_END;
+	ft[n].frequency = CPUFREQ_TABLE_END;
 
 	for (cpu = cl->first_cpu; cpu <= cl->last_cpu; cpu++)
 		if (cpu_possible(cpu))
@@ -109,13 +173,43 @@ static int z3s_cpufreq_init(struct cpufreq_policy *policy)
 	policy->cpuinfo.transition_latency = 2 * NSEC_PER_MSEC;
 
 	if (!cl->cur_khz)
-		cl->cur_khz = cl->khz[cl->n - 1];
+		cl->cur_khz = cl->mif_safe_max_khz;
 
 	return 0;
 }
 
+static void z3s_cpufreq_ready(struct cpufreq_policy *policy)
+{
+	struct z3s_cluster *cl = policy->driver_data;
+	unsigned long now = jiffies;
+	int ret;
+
+	if (!cl || !time_before(now, z3s_boot_qos_deadline))
+		return;
+
+	mutex_lock(&z3s_qos_lock);
+	if (!freq_qos_request_active(&cl->boot_min_req)) {
+		ret = freq_qos_add_request(&policy->constraints,
+					   &cl->boot_min_req, FREQ_QOS_MIN,
+					   cl->boot_min_khz);
+		if (ret >= 0)
+			schedule_delayed_work(&cl->boot_qos_work,
+					      z3s_boot_qos_deadline - now);
+	}
+	mutex_unlock(&z3s_qos_lock);
+}
+
 static void z3s_cpufreq_exit(struct cpufreq_policy *policy)
 {
+	struct z3s_cluster *cl = policy->driver_data;
+
+	if (cl) {
+		cancel_delayed_work_sync(&cl->boot_qos_work);
+		mutex_lock(&z3s_qos_lock);
+		if (freq_qos_request_active(&cl->boot_min_req))
+			freq_qos_remove_request(&cl->boot_min_req);
+		mutex_unlock(&z3s_qos_lock);
+	}
 	kfree(policy->freq_table);
 }
 
@@ -124,17 +218,19 @@ static struct cpufreq_driver z3s_cpufreq_driver = {
 	.flags		= CPUFREQ_NEED_INITIAL_FREQ_CHECK |
 			  CPUFREQ_HAVE_GOVERNOR_PER_POLICY |
 			  CPUFREQ_IS_COOLING_DEV,
-	.verify		= cpufreq_generic_frequency_table_verify,
+	.verify		= z3s_cpufreq_verify,
 	.target_index	= z3s_target_index,
 	.get		= z3s_get,
 	.init		= z3s_cpufreq_init,
 	.exit		= z3s_cpufreq_exit,
+	.ready		= z3s_cpufreq_ready,
 	.attr		= cpufreq_generic_attr,
 };
 
 static int z3s_cpufreq_probe(struct platform_device *pdev)
 {
 	struct device_node *np;
+	unsigned int i;
 	int ret;
 
 	np = of_find_compatible_node(NULL, NULL, "samsung,exynos990-acpm-ipc");
@@ -147,13 +243,21 @@ static int z3s_cpufreq_probe(struct platform_device *pdev)
 		return dev_err_probe(&pdev->dev, PTR_ERR(z3s_acpm),
 				     "waiting for ACPM provider\n");
 
+	for (i = 0; i < ARRAY_SIZE(clusters); i++)
+		INIT_DELAYED_WORK(&clusters[i].boot_qos_work,
+				  z3s_boot_qos_release_work);
+
+	z3s_boot_qos_deadline = jiffies + msecs_to_jiffies(Z3S_BOOT_QOS_HOLD_MS);
+
 	ret = cpufreq_register_driver(&z3s_cpufreq_driver);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret,
 				     "failed to register cpufreq driver\n");
 
-	dev_info(&pdev->dev, "exynos990-cpufreq: registered (ACPM DVFS ch %d, cooling enabled)\n",
-		 ACPM_DVFS_CHANNEL);
+	dev_info(&pdev->dev,
+		 "exynos990-cpufreq: registered (ACPM DVFS ch %d, cooling enabled, MIF-safe ceilings CL0=%u CL1=%u CL2=%u kHz)\n",
+		 ACPM_DVFS_CHANNEL, clusters[0].mif_safe_max_khz,
+		 clusters[1].mif_safe_max_khz, clusters[2].mif_safe_max_khz);
 	return 0;
 }
 
@@ -200,7 +304,7 @@ static void __exit z3s_cpufreq_module_exit(void)
 	platform_driver_unregister(&exynos990_cpufreq_platdrv);
 }
 
-module_init(z3s_cpufreq_module_init);
+late_initcall(z3s_cpufreq_module_init);
 module_exit(z3s_cpufreq_module_exit);
 MODULE_DESCRIPTION("Exynos990 ACPM cpufreq driver");
 MODULE_LICENSE("GPL");
-- 
2.56.1

