From 932a7023c8d20567534196c0f69f199890a20056 Mon Sep 17 00:00:00 2001
From: Boros Maintainer <boros@local>
Date: Tue, 24 Nov 2026 06:34:06 +0800
Subject: [PATCH 08/10] cpufreq: exynos990: use platform_driver for deferred
 ACPM probe and enable thermal cooling

---
 drivers/cpufreq/exynos990-cpufreq.c | 84 +++++++++++++++++++----------
 1 file changed, 56 insertions(+), 28 deletions(-)

diff --git a/drivers/cpufreq/exynos990-cpufreq.c b/drivers/cpufreq/exynos990-cpufreq.c
index 4dfd44e33..b8ca499f9 100644
--- a/drivers/cpufreq/exynos990-cpufreq.c
+++ b/drivers/cpufreq/exynos990-cpufreq.c
@@ -1,11 +1,12 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Exynos990 ACPM cpufreq driver (z3s).
+ * Exynos990 ACPM cpufreq driver (y2s / z3s).
  *
- * Drives the three CPU clusters (CPUCL0/1/2) via the ACPM DVFS channel.
+ * Drives the three CPU clusters (CPUCL0/1/2) via the ACPM DVFS channel (ch 5).
  * ACPM performs the matching voltage transition, so the driver only requests
  * frequencies. get_rate is not reliable on this firmware, so .get returns the
- * cached target. Built as a module for iteration.
+ * cached target. Uses a platform_driver so -EPROBE_DEFER is retried cleanly
+ * when ACPM probes after device_initcall.
  */
 #include <linux/cpu.h>
 #include <linux/cpufreq.h>
@@ -99,7 +100,6 @@ static int z3s_cpufreq_init(struct cpufreq_policy *policy)
 		ft[i].frequency = cl->khz[i];
 	ft[cl->n].frequency = CPUFREQ_TABLE_END;
 
-	/* claim all online siblings in this cluster */
 	for (cpu = cl->first_cpu; cpu <= cl->last_cpu; cpu++)
 		if (cpu_possible(cpu))
 			cpumask_set_cpu(cpu, policy->cpus);
@@ -108,7 +108,6 @@ static int z3s_cpufreq_init(struct cpufreq_policy *policy)
 	policy->driver_data = cl;
 	policy->cpuinfo.transition_latency = 2 * NSEC_PER_MSEC;
 
-	/* seed the cache with the top OPP so .get is sane before first switch */
 	if (!cl->cur_khz)
 		cl->cur_khz = cl->khz[cl->n - 1];
 
@@ -123,7 +122,8 @@ static void z3s_cpufreq_exit(struct cpufreq_policy *policy)
 static struct cpufreq_driver z3s_cpufreq_driver = {
 	.name		= "exynos990-acpm",
 	.flags		= CPUFREQ_NEED_INITIAL_FREQ_CHECK |
-			  CPUFREQ_HAVE_GOVERNOR_PER_POLICY,
+			  CPUFREQ_HAVE_GOVERNOR_PER_POLICY |
+			  CPUFREQ_IS_COOLING_DEV,
 	.verify		= cpufreq_generic_frequency_table_verify,
 	.target_index	= z3s_target_index,
 	.get		= z3s_get,
@@ -132,44 +132,72 @@ static struct cpufreq_driver z3s_cpufreq_driver = {
 	.attr		= cpufreq_generic_attr,
 };
 
-static int __init z3s_cpufreq_module_init(void)
+static int z3s_cpufreq_probe(struct platform_device *pdev)
 {
 	struct device_node *np;
 	int ret;
 
-	z3s_pdev = platform_device_register_simple("exynos990-cpufreq",
-						   PLATFORM_DEVID_NONE, NULL, 0);
-	if (IS_ERR(z3s_pdev))
-		return PTR_ERR(z3s_pdev);
-
 	np = of_find_compatible_node(NULL, NULL, "samsung,exynos990-acpm-ipc");
-	if (!np) {
-		ret = -ENODEV;
-		goto err;
-	}
-	z3s_acpm = devm_acpm_get_by_node(&z3s_pdev->dev, np);
+	if (!np)
+		return -ENODEV;
+
+	z3s_acpm = devm_acpm_get_by_node(&pdev->dev, np);
 	of_node_put(np);
-	if (IS_ERR(z3s_acpm)) {
-		ret = PTR_ERR(z3s_acpm);
-		goto err;
-	}
+	if (IS_ERR(z3s_acpm))
+		return dev_err_probe(&pdev->dev, PTR_ERR(z3s_acpm),
+				     "waiting for ACPM provider\n");
 
 	ret = cpufreq_register_driver(&z3s_cpufreq_driver);
 	if (ret)
-		goto err;
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to register cpufreq driver\n");
 
-	pr_info("exynos990-cpufreq: registered (ACPM DVFS ch %d)\n",
-		ACPM_DVFS_CHANNEL);
+	dev_info(&pdev->dev, "exynos990-cpufreq: registered (ACPM DVFS ch %d, cooling enabled)\n",
+		 ACPM_DVFS_CHANNEL);
 	return 0;
-err:
-	platform_device_unregister(z3s_pdev);
-	return ret;
 }
 
-static void __exit z3s_cpufreq_module_exit(void)
+static void z3s_cpufreq_remove(struct platform_device *pdev)
 {
 	cpufreq_unregister_driver(&z3s_cpufreq_driver);
+}
+
+static struct platform_driver exynos990_cpufreq_platdrv = {
+	.probe		= z3s_cpufreq_probe,
+	.remove_new	= z3s_cpufreq_remove,
+	.driver = {
+		.name	= "exynos990-cpufreq",
+	},
+};
+
+static int __init z3s_cpufreq_module_init(void)
+{
+	struct device_node *np;
+	int ret;
+
+	np = of_find_compatible_node(NULL, NULL, "samsung,exynos990-acpm-ipc");
+	if (!np)
+		return -ENODEV;
+	of_node_put(np);
+
+	ret = platform_driver_register(&exynos990_cpufreq_platdrv);
+	if (ret)
+		return ret;
+
+	z3s_pdev = platform_device_register_simple("exynos990-cpufreq",
+						   PLATFORM_DEVID_NONE, NULL, 0);
+	if (IS_ERR(z3s_pdev)) {
+		platform_driver_unregister(&exynos990_cpufreq_platdrv);
+		return PTR_ERR(z3s_pdev);
+	}
+
+	return 0;
+}
+
+static void __exit z3s_cpufreq_module_exit(void)
+{
 	platform_device_unregister(z3s_pdev);
+	platform_driver_unregister(&exynos990_cpufreq_platdrv);
 }
 
 module_init(z3s_cpufreq_module_init);
-- 
2.56.1

